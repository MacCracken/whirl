[package]
name = "whirl"
version = "${file:VERSION}"
description = "whirl — curl + wget unified: HTTP / HTTPS transfer in one verb (sovereign Cyrius)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "whirl"

[deps]
# `io` carries file_write_all for `-o`. Transport (TCP + DNS) comes from taar
# below — sovereign raw-syscall, no stdlib net. HTTPS opts in to the crypto/TLS
# libs (vendored via `cyrius lib sync`): tls_native is transport-agnostic, wired
# over taar's socket. ct/keccak/random/bayan are sigil's crypto deps.
# `dynlib`+`fdlopen` back the `tls` facade's libssl.so.3 bridge. From v5.6.37
# to 6.6.8 they HAD to be named here or the Linux build failed reachable-undef.
# Since 6.6.9 tls.cyr includes lib/fdlopen.cyr itself (which includes dynlib),
# so from 6.6.9 on these two entries are redundant: dropping them still builds
# (same size, different include order → not byte-identical). Kept in a
# toolchain-only release so the image layout doesn't churn. On --agnos they
# compile (the Linux path is `#ifndef CYRIUS_TARGET_AGNOS`-gated) and stay
# unreachable (the agnos TLS path calls tls_native directly) → DCE'd.
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "args", "flags", "chrono", "ct", "keccak", "random", "bayan", "sigil", "dynlib", "fdlopen", "tls_native", "tls"]

# Network-probe substrate — whirl is the third consumer (after yo + dig). taar's
# socket (taar_tcp_*) + dns (taar_resolve_ipv4) modules back whirl's transport;
# unlike yo's, whirl's half is live on both targets, not DCE'd.
# `git`+`tag` is what every default build resolves, locally and in CI. `path`
# is a DEV OVERRIDE (cyrius ≥ 6.7.6), read only in local mode (`CYRIUS_LOCAL=1`
# or `--local`). Local mode builds the sibling's working tree into
# build/local-deps/ and leaves lib/ and cyrius.lock alone. A default build
# prints a hint naming the unused checkout. Before 6.7.6 `path` silently won
# whenever ../taar existed, which is why 0.6.15 commented it out (0.6.14's lock
# had recorded taar 0.5.1 while this file said 0.5.0); 0.7.0 restores it.
# 0.6.2 is taar's latest tag (pinned to cyrius 6.7.18), an audit release.
# Three changes reach whirl. `taar_tcp_set_timeout_ms` now also sets
# SO_SNDTIMEO, so whirl's 10 s timeout bounds the connect and the send as well
# as the recv: a blackholed host fails in ~10 s, not ~127 s of SYN retries. A
# send that writes nothing returns _TAAR_ERR_TIMEOUT, which
# `_transport_send_all`'s `w < 0` already maps to TRANSPORT_ERR_SEND. And a
# resolv.conf naming only resolvers taar cannot use (IPv6, 0.0.0.0) now fails
# the resolve instead of silently querying 8.8.8.8. The bundle opens with a
# `# Requires` block, and `dist/taar.deps` lists only `syscalls`+`fmt`, both of
# which whirl declares above.
# socket+dns shipped at 0.2.0; the AGNOS sovereign backend landed at 0.3.0.
# 0.5.0 is the minimum: fail-closed DNS query-ID entropy (0.3.1 ignored
# the /dev/urandom read result), RFC 5452 reply acceptance, TC→TCP-53 fallback
# (0.4.0), and arch-dispatched `sys_*` wrappers in place of hardcoded x86_64
# syscall numbers. Its AGNOS `taar_tcp_recv` returns _TAAR_ERR_TIMEOUT (-11)
# rather than 0 on deadline expiry — whirl's `n <= 0` read loops already absorb it.
[deps.taar]
git = "https://github.com/MacCracken/taar.git"
path = "../taar"
tag = "0.6.2"
modules = ["dist/taar.cyr"]

# --- HTTPS deps land with the TLS bite ---
# stdlib "tls_native" + "sigil" — tls_native is transport-agnostic
# (tls_native_set_transport(read,write,now)), wired over taar's socket on agnos
# (see docs/development/roadmap.md § AGNOS call surface).
