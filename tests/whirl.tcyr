# whirl test suite. Pure-logic coverage (no network — the transport layer is
# exercised by the real binary). URL parsing + HTTP/1.1 request build / response
# parse / chunked decode.
#
# Stdlib auto-included via cyrius.cyml.

include "src/version.cyr"
include "src/util.cyr"
include "src/url.cyr"
include "src/http.cyr"
include "src/links.cyr"
include "src/crawl.cyr"

# === URL ===

fn test_url_basic() {
    test_group("url-basic");
    var u = url_new();
    assert_eq(url_parse("http://example.com", u), URL_PARSE_OK, "parse http ok");
    assert_eq(url_is_https(u), 0, "http not https");
    assert_eq(url_port(u), 80, "default port 80");
    assert_eq(streq(url_host(u), "example.com"), 1, "host example.com");
    assert_eq(streq(url_path(u), "/"), 1, "default path /");
}

fn test_url_https_port_path() {
    test_group("url-https");
    var u = url_new();
    assert_eq(url_parse("https://a.b.c:8443/x/y?z=1", u), URL_PARSE_OK, "parse https ok");
    assert_eq(url_is_https(u), 1, "is https");
    assert_eq(url_port(u), 8443, "explicit port 8443");
    assert_eq(streq(url_host(u), "a.b.c"), 1, "host a.b.c");
    assert_eq(streq(url_path(u), "/x/y?z=1"), 1, "path with query preserved");
}

fn test_url_https_default_port() {
    test_group("url-https-default");
    var u = url_new();
    assert_eq(url_parse("https://example.com/", u), URL_PARSE_OK, "ok");
    assert_eq(url_port(u), 443, "default https port 443");
    assert_eq(streq(url_path(u), "/"), 1, "path /");
}

fn test_url_rejects() {
    test_group("url-reject");
    var u = url_new();
    assert_eq(url_parse("ftp://x", u),         URL_PARSE_FAIL, "reject ftp scheme");
    assert_eq(url_parse("http://", u),         URL_PARSE_FAIL, "reject empty host");
    assert_eq(url_parse("http://h:99999/", u), URL_PARSE_FAIL, "reject port > 65535");
    assert_eq(url_parse("notaurl", u),         URL_PARSE_FAIL, "reject missing scheme");
}

# === HTTP ===

fn test_url_filename() {
    test_group("url-filename");
    assert_eq(streq(url_filename("/a/b/file.html"), "file.html"), 1, "last path segment");
    assert_eq(streq(url_filename("/a/b/file.html?x=1"), "file.html"), 1, "strip ?query");
    assert_eq(streq(url_filename("/"), "index.html"), 1, "root -> index.html");
    assert_eq(streq(url_filename("/dir/"), "index.html"), 1, "trailing slash -> index.html");
    assert_eq(streq(url_filename("/just"), "just"), 1, "single segment");
}

fn test_http_build() {
    test_group("http-build");
    var buf = alloc(256);
    var n = http_build_get("example.com", "/", buf, 256);
    assert_eq(_http_match_ci(buf, 0, n, "get / http/1.1"), 1, "request line");
    assert_eq(http_body_offset(buf, n), n, "request ends with CRLFCRLF");
}

fn test_http_status() {
    test_group("http-status");
    var r1 = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello";
    assert_eq(http_status_code(r1, strlen(r1)), 200, "status 200");
    var r2 = "HTTP/1.0 404 Not Found\r\n\r\n";
    assert_eq(http_status_code(r2, strlen(r2)), 404, "status 404");
    var r3 = "HTTP/1.1 301 Moved Permanently\r\nLocation: https://x/\r\n\r\n";
    assert_eq(http_status_code(r3, strlen(r3)), 301, "status 301");
}

fn test_http_headers() {
    test_group("http-headers");
    var r = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: 11\r\n\r\nhello world";
    assert_eq(http_content_length(r, strlen(r)), 11, "content-length 11");
    var bo = http_body_offset(r, strlen(r));
    assert_eq(load8(r + bo), 104, "body starts at 'h'");
    var r2 = "HTTP/1.1 301 X\r\nLocation: http://dst/path\r\n\r\n";
    var lv = http_header_value(r2, strlen(r2), "location");
    assert_eq(_http_match_ci(r2, lv, strlen(r2), "http://dst/path"), 1, "case-insensitive header name");
    assert_eq(http_content_length(r2, strlen(r2)), 0 - 1, "no content-length -> -1");
}

fn test_http_chunked() {
    test_group("http-chunked");
    var r = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n";
    assert_eq(http_is_chunked(r, strlen(r)), 1, "is chunked");
    var bo = http_body_offset(r, strlen(r));
    var out = alloc(64);
    var n = http_dechunk(r + bo, strlen(r) - bo, out, 64);
    assert_eq(n, 11, "dechunk len 11 (hello world)");
    assert_eq(load8(out + 0), 104, "out[0] = h");
    assert_eq(load8(out + 5), 32, "out[5] = space");
    assert_eq(load8(out + 6), 119, "out[6] = w");
}

fn test_http_request_post() {
    test_group("http-request-post");
    var buf = alloc(512);
    var body = "a=1&b=2";
    var n = http_build_request("POST", "x.org", "/p", 0, 0, body, 7, buf, 512);
    assert_eq(_http_match_ci(buf, 0, n, "post /p http/1.1"), 1, "request line = POST /p");
    assert_eq(http_content_length(buf, n), 7, "content-length 7");
    var bo = http_body_offset(buf, n);
    assert_eq(_http_match_ci(buf, bo, n, "a=1&b=2"), 1, "body follows the blank line");
    var ctv = http_header_value(buf, n, "content-type");
    assert_eq(_http_match_ci(buf, ctv, n, "application/x-www-form-urlencoded"), 1, "default content-type");
}

fn test_http_custom_headers() {
    test_group("http-headers-custom");
    var buf = alloc(512);
    var hdrs = alloc(16);
    store64(hdrs + 0, "X-Foo: bar");
    store64(hdrs + 8, "Content-Type: application/json");
    var n = http_build_request("POST", "x.org", "/", hdrs, 2, "{}", 2, buf, 512);
    var xv = http_header_value(buf, n, "x-foo");
    assert_eq(_http_match_ci(buf, xv, n, "bar"), 1, "custom header X-Foo present");
    var ctv = http_header_value(buf, n, "content-type");
    assert_eq(_http_match_ci(buf, ctv, n, "application/json"), 1, "caller Content-Type wins over default");
}

fn test_links() {
    test_group("links");
    var html = "<a href=\"/a.html\">x</a> <img src='img/p.png'> <a href=http://x.org/y>z</a> mysrc=skipme";
    var out = alloc(16 * 8);
    var n = links_extract(html, strlen(html), out, 16);
    assert_eq(n, 3, "3 links (mysrc= skipped at word boundary)");
    assert_eq(streq(load64(out + 0), "/a.html"), 1, "href double-quoted");
    assert_eq(streq(load64(out + 8), "img/p.png"), 1, "src single-quoted");
    assert_eq(streq(load64(out + 16), "http://x.org/y"), 1, "href unquoted");
}

fn test_path_normalize() {
    test_group("path-normalize");
    assert_eq(streq(links_path_normalize("/a/b/../c"), "/a/c"), 1, "../ pops a segment");
    assert_eq(streq(links_path_normalize("/a/./b"), "/a/b"), 1, ". is skipped");
    assert_eq(streq(links_path_normalize("/a/b/../../x"), "/x"), 1, "double ..");
    assert_eq(streq(links_path_normalize("/a/"), "/a/"), 1, "trailing slash kept");
    assert_eq(streq(links_path_normalize("/"), "/"), 1, "root stays /");
    assert_eq(streq(links_path_normalize("/a//b"), "/a/b"), 1, "empty segment collapsed");
}

# === 0.6.6 security regressions ===

# A redirect Location / crawled href reaches url_parse with attacker bytes in
# it. Anything that could break the request line or Host header must be
# rejected here, at the single choke point, rather than being written into the
# request unescaped (request splitting).
fn test_url_rejects_injection() {
    test_group("url-reject-injection");
    var u = url_new();
    assert_eq(url_parse("http://evil.test/a HTTP/1.1\nX-Injected: 1", u), URL_PARSE_FAIL, "bare LF in path rejected");
    assert_eq(url_parse("http://evil.test/a\r\nX-Injected: 1", u), URL_PARSE_FAIL, "CRLF in path rejected");
    assert_eq(url_parse("http://evil.test/a b", u), URL_PARSE_FAIL, "space in path rejected");
    assert_eq(url_parse("http://ev\r\nil.test/", u), URL_PARSE_FAIL, "CRLF in host rejected");
    assert_eq(url_parse("http://ev il.test/", u), URL_PARSE_FAIL, "space in host rejected");
    assert_eq(url_parse("http://evil.test/a\tb", u), URL_PARSE_FAIL, "tab in path rejected");
    # Legitimate URLs must still parse — the check must not over-reject.
    assert_eq(url_parse("http://example.com/a/b?q=1&r=2#frag", u), URL_PARSE_OK, "ordinary URL still ok");
    assert_eq(url_parse("https://example.com:8443/p%20q", u), URL_PARSE_OK, "percent-encoded space still ok");
}

# Credential headers must be recognised case-insensitively so the redirect path
# can drop them when a hop crosses origin.
fn test_credential_headers() {
    test_group("credential-headers");
    assert_eq(http_hdr_is_credential("Authorization: Bearer x"), 1, "Authorization matched");
    assert_eq(http_hdr_is_credential("authorization: Bearer x"), 1, "lowercase matched");
    assert_eq(http_hdr_is_credential("AUTHORIZATION: Bearer x"), 1, "uppercase matched");
    assert_eq(http_hdr_is_credential("Cookie: a=b"), 1, "Cookie matched");
    assert_eq(http_hdr_is_credential("Proxy-Authorization: x"), 1, "Proxy-Authorization matched");
    assert_eq(http_hdr_is_credential("Accept: */*"), 0, "Accept not a credential");
    assert_eq(http_hdr_is_credential("X-Auth: x"), 0, "X-Auth not matched");
    assert_eq(http_hdr_is_credential("Auth"), 0, "short line does not overrun");
    assert_eq(http_hdr_is_credential(""), 0, "empty line does not overrun");
}

# === crawl logic (0.6.7: reachable now that it lives in src/crawl.cyr) ===

# The confinement boundary behind the 0.6.6 remote-arbitrary-file-write fix.
fn test_tree_relpath() {
    test_group("tree-relpath");
    assert_eq(streq(tree_relpath("/docs/g.html"), "docs/g.html"), 1, "leading slash stripped");
    assert_eq(streq(tree_relpath("/a/b/c.txt"), "a/b/c.txt"), 1, "nested path kept");
    assert_eq(streq(tree_relpath("/"), "index.html"), 1, "root -> index.html");
    assert_eq(streq(tree_relpath("/d/"), "d/index.html"), 1, "dir -> index.html");
    assert_eq(streq(tree_relpath("/p.html?x=1"), "p.html"), 1, "query stripped");
    # Escapes must be refused, not sanitized into something plausible.
    assert_eq(tree_relpath("/../../etc/passwd"), 0, "dotdot refused");
    assert_eq(tree_relpath("/a/../../../b"), 0, "interior dotdot refused");
    assert_eq(tree_relpath("/.."), 0, "trailing dotdot refused");
    # The variant that survived a single leading-slash strip as an absolute path.
    assert_eq(streq(tree_relpath("//tmp/x"), "tmp/x"), 1, "all leading slashes stripped");
    assert_eq(streq(tree_relpath("////tmp/x"), "tmp/x"), 1, "many leading slashes stripped");
    # "..text" is a normal name, not a traversal segment.
    assert_eq(streq(tree_relpath("/..hidden"), "..hidden"), 1, "dotdot prefix is not a segment");
}

# A non-default port must survive into the authority, or Host and every
# resolved link point at the wrong service.
fn test_authority() {
    test_group("authority");
    assert_eq(streq(_authority("example.com", 0, 80), "example.com"), 1, "http default port omitted");
    assert_eq(streq(_authority("example.com", 1, 443), "example.com"), 1, "https default port omitted");
    assert_eq(streq(_authority("example.com", 0, 8080), "example.com:8080"), 1, "http odd port kept");
    assert_eq(streq(_authority("example.com", 1, 8443), "example.com:8443"), 1, "https odd port kept");
    assert_eq(streq(_authority("example.com", 0, 443), "example.com:443"), 1, "443 kept on http");
}

fn test_abs_location() {
    test_group("abs-location");
    # Absolute passes through.
    assert_eq(streq(_abs_location("http://other.test/x", 0, "a.test", 80, "/p"), "http://other.test/x"), 1, "absolute unchanged");
    # Root-relative and relative resolve against the base, KEEPING the port.
    assert_eq(streq(_abs_location("/docs/", 0, "a.test", 80, "/p"), "http://a.test/docs/"), 1, "root-relative");
    assert_eq(streq(_abs_location("/docs/", 0, "a.test", 8080, "/p"), "http://a.test:8080/docs/"), 1, "root-relative keeps port");
    assert_eq(streq(_abs_location("b.html", 0, "a.test", 8080, "/d/a.html"), "http://a.test:8080/d/b.html"), 1, "relative keeps port");
    assert_eq(streq(_abs_location("/x", 1, "a.test", 8443, "/p"), "https://a.test:8443/x"), 1, "https keeps port");
    # Protocol-relative inherits the scheme.
    assert_eq(streq(_abs_location("//h.test/x", 1, "a.test", 443, "/p"), "https://h.test/x"), 1, "protocol-relative");
    # Non-http schemes are not followed.
    assert_eq(_abs_location("mailto:x@y.z", 0, "a.test", 80, "/p"), 0, "mailto refused");
    assert_eq(_abs_location("javascript:alert(1)", 0, "a.test", 80, "/p"), 0, "javascript refused");
}

# Origin = scheme + host + port. Anything less let an https crawl follow a
# cleartext link, or leak a credential to another port on the same host.
fn test_same_origin() {
    test_group("same-origin");
    var u = url_new();
    assert_eq(url_parse("http://a.test/x", u), URL_PARSE_OK, "parse base");
    assert_eq(_same_origin(0, "a.test", 80, u), 1, "identical origin");
    assert_eq(_same_origin(0, "A.TEST", 80, u), 1, "host compare is case-insensitive");
    assert_eq(_same_origin(0, "b.test", 80, u), 0, "different host");
    assert_eq(_same_origin(1, "a.test", 80, u), 0, "different scheme");
    assert_eq(_same_origin(0, "a.test", 8080, u), 0, "different port");
    var v = url_new();
    assert_eq(url_parse("https://a.test:8443/x", v), URL_PARSE_OK, "parse https base");
    assert_eq(_same_origin(1, "a.test", 8443, v), 1, "https odd port matches");
    assert_eq(_same_origin(1, "a.test", 443, v), 0, "https port mismatch");
}

fn test_resolve_link_port() {
    test_group("resolve-link-port");
    assert_eq(streq(_resolve_link("/a.html", 0, "h.test", 8080, "/i.html"), "http://h.test:8080/a.html"), 1, "root-relative keeps port");
    assert_eq(streq(_resolve_link("a.html", 0, "h.test", 8080, "/d/i.html"), "http://h.test:8080/d/a.html"), 1, "relative keeps port");
    assert_eq(streq(_resolve_link("/a.html", 0, "h.test", 80, "/i.html"), "http://h.test/a.html"), 1, "default port omitted");
    assert_eq(_resolve_link("#frag", 0, "h.test", 80, "/i.html"), 0, "fragment skipped");
    assert_eq(_resolve_link("mailto:a@b.c", 0, "h.test", 80, "/i.html"), 0, "mailto skipped");
}

# === shared helpers (0.6.8: src/util.cyr) ===

fn test_util_helpers() {
    test_group("util");
    assert_eq(util_has_prefix("http://x", "http://"), 1, "prefix match");
    assert_eq(util_has_prefix("https://x", "http://"), 0, "prefix mismatch");
    assert_eq(util_has_prefix("ht", "http://"), 0, "short subject does not overrun");
    assert_eq(util_has_prefix("anything", ""), 1, "empty prefix matches");

    assert_eq(util_has_prefix_ci("Content-Type: x", "content-type:"), 1, "ci prefix match");
    assert_eq(util_has_prefix_ci("CONTENT-TYPE: x", "content-type:"), 1, "ci upper match");
    assert_eq(util_has_prefix_ci("Content-Len: x", "content-type:"), 0, "ci mismatch");
    assert_eq(util_has_prefix_ci("Con", "content-type:"), 0, "ci short does not overrun");

    assert_eq(util_streq_ci("Example.COM", "example.com"), 1, "ci equal");
    assert_eq(util_streq_ci("example.com", "example.org"), 0, "ci unequal");
    assert_eq(util_streq_ci("", ""), 1, "both empty equal");
    assert_eq(util_streq_ci("a", "ab"), 0, "prefix is not equality");

    assert_eq(streq(util_dup_range("hello world", 5), "hello"), 1, "dup_range copies n bytes");
    assert_eq(streq(util_dup_range("hello", 0), ""), 1, "dup_range zero length");
    assert_eq(streq(util_concat2("foo", "bar"), "foobar"), 1, "concat2");
    assert_eq(streq(util_concat2("", "bar"), "bar"), 1, "concat2 empty lhs");
    assert_eq(streq(util_concat2("foo", ""), "foo"), 1, "concat2 empty rhs");
}

# The extractor clamps to the caller's array; links_found() reports the true
# total so the crawl can say what it did not see (0.6.8).
fn test_links_found() {
    test_group("links-found");
    var out = xalloc(4 * 8);
    var html = "<a href=\"/1\"><a href=\"/2\"><a href=\"/3\"><a href=\"/4\"><a href=\"/5\">";
    var n = links_extract(html, strlen(html), out, 2);
    assert_eq(n, 2, "stored count clamped to capacity");
    assert_eq(links_found(), 5, "found count reports all five");
    var n2 = links_extract(html, strlen(html), out, 4);
    assert_eq(n2, 4, "clamped to 4");
    assert_eq(links_found(), 5, "found count still five");
    var none = "<p>no links</p>";
    assert_eq(links_extract(none, strlen(none), out, 4), 0, "no links stored");
    assert_eq(links_found(), 0, "found count reset per call");
}

fn main() {
    alloc_init();
    test_links();
    test_path_normalize();
    test_url_basic();
    test_url_https_port_path();
    test_url_https_default_port();
    test_url_rejects();
    test_url_filename();
    test_http_build();
    test_http_status();
    test_http_headers();
    test_http_chunked();
    test_http_request_post();
    test_http_custom_headers();
    test_url_rejects_injection();
    test_credential_headers();
    test_tree_relpath();
    test_authority();
    test_abs_location();
    test_same_origin();
    test_resolve_link_port();
    test_util_helpers();
    test_links_found();
    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
