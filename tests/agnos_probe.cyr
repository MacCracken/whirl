# whirl — AGNOS path probe.
#
# Roadmap A2. The QEMU smoke (`agnos/scripts/smoke/whirl-smoke.sh`) drives three
# commands — `--help`, an HTTP fetch, an HTTPS fetch — so three `#ifdef
# CYRIUS_TARGET_AGNOS` regions ship without ever being executed:
#
#   1. the agnos trust store: `_agnos_ca_install` (tls_native_set_ca_system since
#      0.7.1, replacing `_agnos_ca_hook`) loads a bundle, every ctx shares one
#      parsed root set, whirl's own `_agnos_tls_native_connect` verifies a valid
#      chain and refuses a self-signed one, and the per-connect heap cost stays
#      bounded. The HTTPS fetch in the smoke *reaches* this path, but checks none
#      of it.
#   2. `output_append`'s agnos read-modify-write and its >1 MiB refusal (0.6.7) —
#      the guard that stops a `-C` resume from destroying the file it resumes.
#   3. `fs_is_symlink`'s agnos branch: readlink#70 detection since 0.6.12, checked
#      against a link and a regular file the harness plants.
#
# It settled roadmap B3/B4. At 0.7.1 its cost check showed the old hook had become
# the expensive path (~272,720 B per connect vs ~656 B), and the hook was retired.
#
# HOW IT RUNS: staged as `/bin/agnsh`, so kybernet execs it at boot and it prints
# to the console unattended. That is deliberate — the smoke drives agnsh through
# an xHCI keyboard that drops characters, and every result here would otherwise
# depend on a command line surviving that. No keyboard, no retries, no typos.
#
# Every line starts `PROBE:` so the harness can grep them out of the serial log,
# and each is PASS / FAIL / INFO. INFO records an observation with no pass-fail
# meaning (a documented gap, or a value worth having on the record).

include "src/version.cyr"
include "src/util.cyr"
include "src/url.cyr"
include "src/http.cyr"
include "src/links.cyr"
include "src/crawl.cyr"
include "src/cli.cyr"
include "lib/taar.cyr"
include "src/transport.cyr"
include "src/output.cyr"

var _fails = 0;

# Write cstr `s` to stdout.
fn p_out(s): i64 { sys_write(1, s, strlen(s)); return 0; }
# Write `n` to stdout in decimal.
fn p_int(n): i64 {
    var b[24];
    var len = fmt_int_buf(n, &b);
    sys_write(1, &b, len);
    return 0;
}

# Report a passing check: `PROBE: PASS <name>`.
fn p_pass(name): i64 { p_out("PROBE: PASS "); p_out(name); p_out("\n"); return 0; }
# Report a failing check: `PROBE: FAIL <name>`, counted in the exit status.
fn p_fail(name): i64 { p_out("PROBE: FAIL "); p_out(name); p_out("\n"); _fails = _fails + 1; return 0; }
# Report a non-assertion line: `PROBE: INFO <name>`.
fn p_info(name): i64 { p_out("PROBE: INFO "); p_out(name); p_out("\n"); return 0; }

# PASS when `ok` is 1, FAIL otherwise.
fn p_check(name, ok): i64 {
    if (ok == 1) { return p_pass(name); }
    return p_fail(name);
}

# --- 1. trust store: what _agnos_ca_install loads -----------------------------

# agnos only: whirl's `_agnos_ca_install` finds a system bundle (TLS_OK), and a
# second ctx is handed the SAME parsed root set instead of parsing its own. That
# sharing is the stdlib's once-per-process cache (cyrius 6.6.13), and it is what
# made the old `_agnos_ca_hook` removable at 0.7.1.
fn probe_ca(): i64 {
    #ifndef CYRIUS_TARGET_AGNOS
    p_info("ca-load SKIPPED (agnos-only path; this is a host build)");
    return 0;
    #endif
    #ifdef CYRIUS_TARGET_AGNOS
    var host = "example.com";
    var c1 = tls_native_new_client(host, strlen(host));
    var c2 = tls_native_new_client(host, strlen(host));
    if ((c1 == 0) || (c2 == 0)) {
        p_fail("ca-new-client (could not build a TLS client ctx)");
        return 0;
    }
    var rc = _agnos_ca_install(c1);
    p_out("PROBE: INFO ca-install-rc ");
    p_int(rc);
    p_out("\n");
    p_check("ca-load (_agnos_ca_install found a system bundle)", rc == TLS_OK);
    p_out("PROBE: INFO ca-skipped-blocks ");
    p_int(tls_native_ca_skipped(c1));
    p_out("\n");

    var rc2 = _agnos_ca_install(c2);
    var r1 = load64(c1 + TLS_CTX_OFF_CA_ROOT);
    var r2 = load64(c2 + TLS_CTX_OFF_CA_ROOT);
    p_check("ca-shared (a second ctx gets the same parsed root set)",
      (rc2 == TLS_OK) && (r1 != 0) && (r1 == r2));
    # Closing both must not disturb the shared set: section 2 handshakes on it,
    # so a close that zeroised it would show up there as a failed good chain.
    tls_native_close(c1);
    tls_native_close(c2);
    return 0;
    #endif
}

# --- 2. trust store: does whirl's agnos TLS connect actually VERIFY? ----------
#
# ca-load proves a bundle loaded. It does not prove the roots are real, or that
# verification still enforces. So run two real handshakes through whirl's own
# `_agnos_tls_native_connect`, the function transport_fetch_tls calls:
#   good: a public host with a valid chain      MUST connect
#   bad:  a self-signed server on the QEMU host MUST be refused
# Both are needed. `good` alone cannot tell a real trust store from a permissive
# one; `bad` alone cannot tell enforcement from an empty store. (Through 0.7.0
# this was roadmap B3's question, asked of set_ca_system in a probe-local
# handshake rather than through whirl's connect.)

# Open a TCP connection to host:port over taar and hand back the fd, or -1.
fn _probe_connect(host, port): i64 {
    var ip = taar_resolve_ipv4(host);
    if (ip < 0) { return 0 - 1; }
    var fd = taar_tcp_open();
    if (fd < 0) { return 0 - 1; }
    taar_tcp_set_timeout_ms(fd, 10000);
    if (taar_tcp_connect(fd, ip, port) < 0) { taar_sock_close(fd); return 0 - 1; }
    return fd;
}

# Handshake through whirl's agnos TLS connect. Returns 1 when it succeeded (chain
# and hostname verified), 0 when it was refused, -900 when TCP could not connect.
fn _probe_handshake(host, port): i64 {
    #ifndef CYRIUS_TARGET_AGNOS
    return 0 - 900;
    #endif
    #ifdef CYRIUS_TARGET_AGNOS
    var fd = _probe_connect(host, port);
    if (fd < 0) { return 0 - 900; }
    tls_native_set_transport(&taar_tcp_recv, &taar_tcp_send, 0);
    var ctx = _agnos_tls_native_connect(fd, host);
    var ok = 0;
    if (ctx != 0) { ok = 1; tls_close(ctx); }
    taar_sock_close(fd);
    return ok;
    #endif
}

# agnos only: whirl's TLS connect accepts example.com's valid chain and refuses
# the harness's self-signed server at 10.0.2.2:18443.
fn probe_verify(): i64 {
    #ifndef CYRIUS_TARGET_AGNOS
    p_info("verify SKIPPED (agnos-only; this is a host build)");
    return 0;
    #endif
    #ifdef CYRIUS_TARGET_AGNOS
    var good = _probe_handshake("example.com", 443);
    p_out("PROBE: INFO verify-good-result ");
    p_int(good);
    p_out("\n");
    p_check("verify-good (valid chain: whirl's agnos TLS connect succeeds)", good == 1);

    # 10.0.2.2 is the QEMU host under SLIRP. The harness runs a self-signed
    # server there whose cert names 10.0.2.2, so a refusal is due to the
    # UNTRUSTED ISSUER and not a hostname mismatch — which is precisely the
    # property the trust store is responsible for.
    var bad = _probe_handshake("10.0.2.2", 18443);
    p_out("PROBE: INFO verify-bad-result ");
    p_int(bad);
    p_out("\n");
    if (bad == (0 - 900)) {
        p_info("verify-bad SKIPPED (no self-signed server reachable at 10.0.2.2:18443)");
        p_fail("verify-bad-inconclusive -- no negative result, so enforcement is unproven");
        return 0;
    }
    p_check("verify-bad (self-signed chain: whirl's agnos TLS connect refuses)", bad == 0);
    return 0;
    #endif
}

# --- 3. trust store: what does each connect cost? -----------------------------
#
# This allocator is a bump allocator with no free, so anything spent per connect
# is permanent. An HTTPS `-r` crawl makes up to 64 connects, plus redirect hops.
# It has gone wrong here twice:
# - set_ca_system re-reading 1 MiB per call (cyrius before v6.5.36), measured at
#   0.6.11 as 1 MiB per connect;
# - the `_agnos_ca_hook` that cached it, parsing the bundle into every ctx:
#   ~272,720 B per connect, measured at 0.7.1, which is why it was removed.
# This pins the current behaviour. Once section 1 has warmed the stdlib's cache,
# `_agnos_ca_install` plus its ctx must cost at most 16 KiB per connect. At 0.7.1
# it measured ~656 B, and a TLS ctx alone is 640 B.
var _PROBE_CA_COST_MAX = 16384;
# agnos only: 8 rounds of new_client + _agnos_ca_install + close stay under the bound.
fn probe_ca_cost(): i64 {
    #ifndef CYRIUS_TARGET_AGNOS
    p_info("ca-cost SKIPPED (agnos-only; this is a host build)");
    return 0;
    #endif
    #ifdef CYRIUS_TARGET_AGNOS
    var rounds = 8;
    var made = 0;
    var host = "example.com";
    var h0 = alloc_used();
    var i = 0;
    while (i < rounds) {
        var c = tls_native_new_client(host, strlen(host));
        if (c != 0) {
            made = made + 1;
            _agnos_ca_install(c);
            tls_native_close(c);
        }
        i = i + 1;
    }
    var per = (alloc_used() - h0) / rounds;
    p_out("PROBE: INFO ca-cost-rounds ");
    p_int(rounds);
    p_out("\n");
    p_out("PROBE: INFO ca-cost-bytes-per-connect ");
    p_int(per);
    p_out("\n");
    p_check("ca-cost-bounded (<= 16 KiB of no-free heap per connect)",
      (made == rounds) && (per <= _PROBE_CA_COST_MAX));
    return 0;
    #endif
}

# --- 4. -C resume: append path and the >1 MiB refusal -------------------------

# output_append extends a small file and keeps its original bytes.
fn probe_resume(): i64 {
    # Root, not /tmp: the agnos rootfs is bin/ + etc/ + fw/ with no /tmp, and the
    # first run of this probe failed on exactly that. Root always exists.
    var path = "/whirl-probe-resume";
    var head = "HEAD";
    if (file_write_all(path, head, 4) < 0) {
        p_fail("resume-setup (could not write the scratch file)");
        return 0;
    }
    p_check("resume-file-size", output_file_size(path) == 4);

    var tail = "TAIL";
    var ar = output_append(tail, 4, path);
    p_check("resume-append-rc", ar == 0);
    p_check("resume-append-grew", output_file_size(path) == 8);

    # Read it back: the append must PRESERVE the original bytes, not just extend
    # the length. The agnos path rebuilds the whole file, so a bug here silently
    # rewrites what was already downloaded.
    var rb = xalloc(64);
    var n = file_read_all(path, rb, 64);
    var intact = 0;
    if (n == 8) {
        if ((load8(rb) == 72) && (load8(rb + 1) == 69) && (load8(rb + 2) == 65) && (load8(rb + 3) == 68)) {
            if ((load8(rb + 4) == 84) && (load8(rb + 5) == 65) && (load8(rb + 6) == 73) && (load8(rb + 7) == 76)) {
                intact = 1;
            }
        }
    }
    p_check("resume-append-content (HEAD preserved, TAIL added)", intact);
    return 0;
}

# The guard: a file larger than the 1 MiB read cap must be REFUSED, and must
# survive the refusal intact. Before 0.6.7 it was read to the cap and written
# back at cap+len, discarding everything past it.
fn probe_resume_guard(): i64 {
    var cap = 1048576;
    var big = cap + 4096;
    var buf = xalloc(big);
    var i = 0;
    while (i < big) { store8(buf + i, 65); i = i + 1; }   # 'A'
    var path = "/whirl-probe-big";
    if (file_write_all(path, buf, big) < 0) {
        p_info("resume-guard SKIPPED (could not stage a >1 MiB file on this fs)");
        return 0;
    }
    var before = output_file_size(path);
    if (before != big) {
        p_info("resume-guard SKIPPED (fs did not store the full >1 MiB file)");
        return 0;
    }
    var tail = "TAIL";
    var ar = output_append(tail, 4, path);
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos read-modify-writes (no O_APPEND in the frozen FS surface), so a file
    # larger than the read cap MUST be refused rather than rebuilt short.
    p_check("resume-guard-refuses", ar < 0);
    p_check("resume-guard-preserves-file", output_file_size(path) == before);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # Linux has real O_APPEND and no cap — the large file is appended to
    # normally. Asserting the agnos refusal here would be asserting a bug.
    p_check("resume-large-append-ok (host: O_APPEND, no cap)", ar == 0);
    p_check("resume-large-append-grew", output_file_size(path) == (before + 4));
    #endif
    return 0;
}

# --- 5. symlink predicate on agnos --------------------------------------------
#
# fs_is_symlink answers 0/1 without faulting on both targets. On agnos it also
# detects the harness's planted link via readlink#70 and does not flag the
# planted regular file (roadmap B1, closed at 0.6.12; before that agnos had no
# way to answer and the predicate returned 0 by construction).
fn probe_symlink(): i64 {
    var r1 = fs_is_symlink("/etc/ssl/cert.pem");
    var r2 = fs_is_symlink("/no/such/path/at/all");
    # r1 is whatever the filesystem says (on a host it may genuinely BE a
    # symlink); only the shape of the answer is asserted here.
    p_check("symlink-callable (returns 0/1 without faulting)",
      ((r1 == 0) || (r1 == 1)) && (r2 == 0));
    p_out("PROBE: INFO symlink-cert-pem ");
    p_int(r1);
    p_out("\n");
    #ifdef CYRIUS_TARGET_AGNOS
    # 0.6.12: agnos detects symlinks for real now, via readlink#70. The harness
    # plants a known link and a known regular file, so this proves DETECTION —
    # a check that only asserted "returns 0 without faulting" would have passed
    # just as happily against the old stub that could never say yes.
    var lnk = fs_is_symlink("/probe-symlink");
    var reg = fs_is_symlink("/probe-regular");
    p_out("PROBE: INFO symlink-planted-link ");
    p_int(lnk);
    p_out(" planted-regular ");
    p_int(reg);
    p_out("\n");
    p_check("symlink-detects-real-link (readlink#70 says yes)", lnk == 1);
    p_check("symlink-regular-not-a-link (no false positive)", reg == 0);
    #endif
    #ifdef CYRIUS_TARGET_AGNOS
    p_info("symlink agnos detection is live via readlink#70 (roadmap B1 closed at 0.6.12)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    p_info("symlink host build: lstat is real here, so 0 means 'not a symlink', not 'cannot tell'");
    #endif
    return 0;
}

# Run every probe and exit with the number of FAIL lines (0 = clean).
fn main() {
    alloc_init();
    p_out("PROBE: BEGIN whirl agnos path probe v");
    p_out(WHIRL_VERSION);
    p_out("\n");

    probe_ca();
    probe_verify();
    probe_ca_cost();
    probe_resume();
    probe_resume_guard();
    probe_symlink();

    p_out("PROBE: FAILURES ");
    p_int(_fails);
    p_out("\n");
    p_out("PROBE: END\n");
    return _fails;
}

var r = main();
syscall(SYS_EXIT, r);
