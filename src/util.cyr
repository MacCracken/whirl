# whirl — small shared helpers.
#
# Carved out at 0.6.8. Each of these existed in three or four near-identical
# copies across url / http / crawl / main: a cstr prefix test, a case-insensitive
# prefix test, a bounded cstr dup, a two-part concat. Duplication of this kind is
# not just noise — the case-insensitive compare is exactly the sort of routine
# where one copy gets a bounds fix and the others do not.
#
# Pure logic apart from xalloc's failure path. Include before every other
# src/ module.

# --- allocation ---

# alloc() returns 0 on failure (a request past ALLOC_MAX, or an mmap that could
# not extend the heap — see lib/alloc.cyr). Every call site in whirl used to
# ignore that and store straight into address 0. There is no useful recovery in
# a one-shot transfer tool, so fail loudly and immediately rather than fault in
# a place that says nothing about the cause.
fn xalloc(n): i64 {
    var p = alloc(n);
    if (p == 0) {
        var m = "whirl: out of memory\n";
        sys_write(2, m, strlen(m));
        syscall(SYS_EXIT, 9);
    }
    return p;
}

# --- string helpers ---

# Does cstr `s` start with cstr `pfx`?
fn util_has_prefix(s, pfx): i64 {
    var i = 0;
    while (load8(pfx + i) != 0) {
        if (load8(s + i) != load8(pfx + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Does cstr `s` start with `pfx`, ASCII-case-insensitively? `pfx` must already
# be lowercase. Safe against a short `s`: the walk hits s's NUL, which cannot
# match a lowercase letter, so it returns 0 before reading past the end.
fn util_has_prefix_ci(s, pfx): i64 {
    var i = 0;
    while (load8(pfx + i) != 0) {
        var c = load8(s + i);
        if ((c >= 65) && (c <= 90)) { c = c + 32; }
        if (c != load8(pfx + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Whole-string ASCII-case-insensitive equality.
fn util_streq_ci(a, b): i64 {
    var i = 0;
    while (1 == 1) {
        var x = load8(a + i);
        var y = load8(b + i);
        if ((x >= 65) && (x <= 90)) { x = x + 32; }
        if ((y >= 65) && (y <= 90)) { y = y + 32; }
        if (x != y) { return 0; }
        if (x == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Copy `len` bytes from `src` into a fresh NUL-terminated cstr.
fn util_dup_range(src, len): i64 {
    if (len < 0) { len = 0; }
    var d = xalloc(len + 1);
    var i = 0;
    while (i < len) { store8(d + i, load8(src + i)); i = i + 1; }
    store8(d + len, 0);
    return d;
}

# Concatenate two cstrs into a fresh cstr.
fn util_concat2(a, b): i64 {
    var la = strlen(a);
    var lb = strlen(b);
    var d = xalloc(la + lb + 1);
    var i = 0;
    while (i < la) { store8(d + i, load8(a + i)); i = i + 1; }
    var j = 0;
    while (j < lb) { store8(d + la + j, load8(b + j)); j = j + 1; }
    store8(d + la + lb, 0);
    return d;
}
