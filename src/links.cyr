# whirl — minimal HTML link extraction for `-r` (recursive fetch).
#
# A pragmatic attribute scan, NOT a full HTML parser: it collects the values of
# `href=` and `src=` attributes into a caller-supplied array of fresh cstrs.
# Over-matching is harmless — a bogus "link" just fails to resolve/fetch and is
# skipped. The attribute must start on a non-alpha boundary so `mysrc=`/`xhref=`
# don't false-match.
#
# Stdlib auto-included via cyrius.cyml.

fn _links_is_alpha(c): i64 {
    if ((c >= 65) && (c <= 90)) { return 1; }
    if ((c >= 97) && (c <= 122)) { return 1; }
    return 0;
}

# 1 for HTML whitespace (space, tab, LF, CR, FF) — what may surround an
# attribute's '='.
fn _links_is_space(c): i64 {
    if ((c == 32) || (c == 9) || (c == 10) || (c == 13) || (c == 12)) { return 1; }
    return 0;
}

# Normalize an absolute path's `.` and `..` segments (RFC 3986 §5.2.4). Returns
# a fresh cstr. "/a/b/../c" -> "/a/c", "/a/./b" -> "/a/b", "/a/../../x" -> "/x".
# A trailing slash on the input is preserved.
#
# 0.7.2: the segment-start table is sized from the path's own segment count. It
# was a fixed 2 KiB per call (256 entries), on a no-free allocator, and a crawl
# normalizes every link it resolves; past 256 segments a `..` also popped to the
# wrong place.
fn links_path_normalize(path): i64 {
    var n = strlen(path);
    var out = xalloc(n + 2);
    var nseg = 1;
    var c = 0;
    while (c < n) { if (load8(path + c) == 47) { nseg = nseg + 1; } c = c + 1; }
    var starts = xalloc(nseg * 8);  # output offset where each kept segment began
    var nstarts = 0;
    var w = 0;
    var i = 0;
    if ((n > 0) && (load8(path) == 47)) { i = 1; }   # skip leading '/'
    while (i <= n) {
        var s = i;
        while ((i < n) && (load8(path + i) != 47)) { i = i + 1; }
        var slen = i - s;
        if (slen == 0) {
            # empty segment (// or trailing) — skip
        }
        elif ((slen == 1) && (load8(path + s) == 46)) {
            # "." — skip
        }
        elif ((slen == 2) && (load8(path + s) == 46) && (load8(path + s + 1) == 46)) {
            if (nstarts > 0) { nstarts = nstarts - 1; w = load64(starts + nstarts * 8); }
        }
        else {
            store64(starts + nstarts * 8, w);
            nstarts = nstarts + 1;
            store8(out + w, 47);
            w = w + 1;
            var k = 0;
            while (k < slen) { store8(out + w, load8(path + s + k)); w = w + 1; k = k + 1; }
        }
        i = i + 1;
    }
    if ((n > 0) && (load8(path + n - 1) == 47) && (w > 0)) { store8(out + w, 47); w = w + 1; }
    if (w == 0) { store8(out, 47); w = 1; }   # root
    store8(out + w, 0);
    return out;
}

# Total link-shaped attributes seen by the last links_extract call, INCLUDING
# any past `outmax`. The return value is clamped to the caller's array, so
# without this a page with more links than capacity looked identical to one that
# fitted exactly — the crawl reported a complete mirror of a partial page.
var _links_found = 0;
# How many links the last links_extract saw, including any it could not store.
fn links_found(): i64 { return _links_found; }

# Extract href/src URL values from html[0..len) into `out` (array of cstr ptrs,
# capacity `outmax`). Returns the count STORED (<= outmax); links_found()
# reports how many were actually present.
fn links_extract(html, len, out, outmax): i64 {
    _links_found = 0;
    var count = 0;
    var i = 0;
    while (i < len) {
        var boundary = 0;
        if (i == 0) { boundary = 1; }
        elif (_links_is_alpha(load8(html + i - 1)) == 0) { boundary = 1; }

        var alen = 0;
        if (boundary == 1) {
            if (util_match_ci(html, i, len, "href") == 1) { alen = 4; }
            elif (util_match_ci(html, i, len, "src") == 1) { alen = 3; }
        }

        if (alen > 0) {
            var j = i + alen;
            while ((j < len) && (_links_is_space(load8(html + j)) == 1)) { j = j + 1; }
            if ((j < len) && (load8(html + j) == 61)) {   # '='
                j = j + 1;
                while ((j < len) && (_links_is_space(load8(html + j)) == 1)) { j = j + 1; }
                var q = 0;
                if (j < len) {
                    var c0 = load8(html + j);
                    if ((c0 == 34) || (c0 == 39)) { q = c0; j = j + 1; }   # " or '
                }
                var s = j;
                var go = 1;
                while ((j < len) && (go == 1)) {
                    var c = load8(html + j);
                    if (q != 0) {
                        if (c == q) { go = 0; } else { j = j + 1; }
                    } else {
                        if ((_links_is_space(c) == 1) || (c == 62)) { go = 0; }
                        else { j = j + 1; }
                    }
                }
                var slen = j - s;
                if (slen > 0) {
                    _links_found = _links_found + 1;
                    if (count < outmax) {
                        var d = xalloc(slen + 1);
                        var m = 0;
                        while (m < slen) { store8(d + m, load8(html + s + m)); m = m + 1; }
                        store8(d + slen, 0);
                        store64(out + count * 8, d);
                        count = count + 1;
                    }
                }
                i = j + 1;
            } else {
                i = i + alen;
            }
        } else {
            i = i + 1;
        }
    }
    return count;
}
