# whirl — HTTP/1.1 request build + response parse.
#
# Pure buffer logic — no I/O. The transport layer feeds it bytes; this module
# frames requests and parses status / headers / body / chunked. Testable against
# canned response buffers.
#
# Stdlib auto-included via cyrius.cyml.

# --- request ---

# http_build_request could not fit the request in `bufmax`. Returned instead of
# a length so a caller cannot mistake a truncated request for a valid one.
var HTTP_REQ_TOOBIG = 0 - 1;

var _http_ua = 0;   # User-Agent override (0 = default whirl/<ver>)

# Set by the append helpers whenever they hit `bufmax` and drop bytes. They
# clamp and return as though they wrote, so an oversized request (many -H
# headers, or a long crawl path) was silently emitted MALFORMED — a half-written
# header line, no terminating CRLFCRLF — and no caller could tell. Reset per
# http_build_request; consulted before returning a length.
var _http_trunc = 0;

# Override the User-Agent (cstr) for every request built after this; 0 restores
# the default `whirl/<version>`.
fn http_set_user_agent(ua): i64 { _http_ua = ua; return 0; }

# Append cstr `s` into buf at pos (bounded by bufmax). Returns the new pos.
fn _http_puts(buf, pos, bufmax, s): i64 {
    var i = 0;
    while (load8(s + i) != 0) {
        if (pos >= bufmax) { _http_trunc = 1; return pos; }
        store8(buf + pos, load8(s + i));
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

# Append one byte. Returns the new pos.
fn _http_putc(buf, pos, bufmax, c): i64 {
    if (pos >= bufmax) { _http_trunc = 1; return pos; }
    store8(buf + pos, c);
    return pos + 1;
}

# Append a non-negative integer (decimal). Returns the new pos.
fn _http_put_int(buf, pos, bufmax, n): i64 {
    var tmp[24];
    var len = fmt_int_buf(n, &tmp);
    var i = 0;
    while (i < len) {
        if (pos >= bufmax) { _http_trunc = 1; return pos; }
        store8(buf + pos, load8(&tmp + i));
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

# 1 if header line `h` carries credentials that must NOT survive a cross-origin
# redirect. Matches curl/wget behaviour: a 302 to another origin gets a fresh
# request with no caller-supplied Authorization / Cookie.
fn http_hdr_is_credential(h): i64 {
    if (util_has_prefix_ci(h, "authorization:") == 1) { return 1; }
    if (util_has_prefix_ci(h, "cookie:") == 1) { return 1; }
    if (util_has_prefix_ci(h, "proxy-authorization:") == 1) { return 1; }
    return 0;
}

# Build an HTTP/1.1 request: "<method> <path>" + Host/UA/Accept/Connection, then
# any caller headers (`hdrs` = array of `nhdrs` cstr ptrs), then — for a body —
# Content-Length + a default Content-Type (unless the caller supplied one). Body
# bytes follow the blank line. Returns total bytes written.
fn http_build_request(method, host, path, hdrs, nhdrs, body, bodylen, buf, bufmax): i64 {
    _http_trunc = 0;
    var p = 0;
    p = _http_puts(buf, p, bufmax, method);
    p = _http_putc(buf, p, bufmax, 32);
    p = _http_puts(buf, p, bufmax, path);
    p = _http_puts(buf, p, bufmax, " HTTP/1.1\r\nHost: ");
    p = _http_puts(buf, p, bufmax, host);
    p = _http_puts(buf, p, bufmax, "\r\nUser-Agent: ");
    if (_http_ua != 0) { p = _http_puts(buf, p, bufmax, _http_ua); }
    else {
        p = _http_puts(buf, p, bufmax, "whirl/");
        p = _http_puts(buf, p, bufmax, WHIRL_VERSION);
    }
    p = _http_puts(buf, p, bufmax, "\r\nAccept: */*\r\nConnection: close\r\n");

    var has_ct = 0;
    var i = 0;
    while (i < nhdrs) {
        var h = load64(hdrs + i * 8);
        if (util_has_prefix_ci(h, "content-type:") == 1) { has_ct = 1; }
        p = _http_puts(buf, p, bufmax, h);
        p = _http_puts(buf, p, bufmax, "\r\n");
        i = i + 1;
    }

    # `body != 0`, not `bodylen > 0`: `-d ''` is an empty body, and a POST without
    # a Content-Length leaves a server to guess (0.7.2).
    if ((body != 0) || (bodylen > 0)) {
        p = _http_puts(buf, p, bufmax, "Content-Length: ");
        p = _http_put_int(buf, p, bufmax, bodylen);
        p = _http_puts(buf, p, bufmax, "\r\n");
        if (has_ct == 0) {
            p = _http_puts(buf, p, bufmax, "Content-Type: application/x-www-form-urlencoded\r\n");
        }
    }

    p = _http_puts(buf, p, bufmax, "\r\n");   # end of headers

    var j = 0;
    while (j < bodylen) {
        if (p >= bufmax) { _http_trunc = 1; return HTTP_REQ_TOOBIG; }
        store8(buf + p, load8(body + j));
        p = p + 1;
        j = j + 1;
    }
    if (_http_trunc == 1) { return HTTP_REQ_TOOBIG; }
    return p;
}

# Back-compat: a plain GET (no body, no extra headers).
fn http_build_get(host, path, buf, bufmax): i64 {
    return http_build_request("GET", host, path, 0, 0, 0, 0, buf, bufmax);
}

# --- response ---

# Parse the status code from "HTTP/1.x <code> ...". Returns 100..599 or -1.
fn http_status_code(resp, len): i64 {
    var i = 0;
    while ((i < len) && (load8(resp + i) != 32)) { i = i + 1; }
    if (i >= len) { return 0 - 1; }
    i = i + 1;
    var code = 0;
    var d = 0;
    while ((i < len) && (d < 3)) {
        var c = load8(resp + i);
        if ((c < 48) || (c > 57)) { return 0 - 1; }
        code = code * 10 + (c - 48);
        i = i + 1;
        d = d + 1;
    }
    if (d != 3) { return 0 - 1; }
    return code;
}

# Offset of the body (just past the CRLFCRLF header terminator), or -1.
fn http_body_offset(resp, len): i64 {
    var i = 0;
    while (i + 3 < len) {
        if (load8(resp + i) == 13) {
            if (load8(resp + i + 1) == 10) {
                if (load8(resp + i + 2) == 13) {
                    if (load8(resp + i + 3) == 10) {
                        return i + 4;
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Advance `off` past the current line's CRLF. Returns the next-line offset.
fn _http_next_line(resp, off, end): i64 {
    var found = 0;
    while ((off + 1 < end) && (found == 0)) {
        if ((load8(resp + off) == 13) && (load8(resp + off + 1) == 10)) { found = 1; }
        else { off = off + 1; }
    }
    return off + 2;
}

# Find header `name` (lowercase, no colon). Returns the offset of its value
# (after ':' and any spaces or tabs), bounded to the header block, or -1.
fn http_header_value(resp, len, name): i64 {
    var hdr_end = http_body_offset(resp, len);
    if (hdr_end < 0) { hdr_end = len; }

    var off = _http_next_line(resp, 0, hdr_end);   # skip the status line
    while (off < hdr_end) {
        if (util_match_ci(resp, off, hdr_end, name) == 1) {
            var nl = 0;
            while (load8(name + nl) != 0) { nl = nl + 1; }
            var k = off + nl;
            if ((k < hdr_end) && (load8(resp + k) == 58)) {   # ':'
                k = k + 1;
                while ((k < hdr_end) && ((load8(resp + k) == 32) || (load8(resp + k) == 9))) { k = k + 1; }
                return k;
            }
        }
        off = _http_next_line(resp, off, hdr_end);
    }
    return 0 - 1;
}

# Copy header `name`'s value into a fresh cstr: from after the colon's whitespace
# to the CR, with trailing spaces and tabs dropped. 0 when absent. 0.7.2: a
# Location with trailing whitespace was copied with it, and url_parse refuses
# whitespace, so the redirect silently stopped being followed.
fn http_header_dup(resp, len, name): i64 {
    var v = http_header_value(resp, len, name);
    if (v < 0) { return 0; }
    var e = v;
    while ((e < len) && (load8(resp + e) != 13) && (load8(resp + e) != 10)) { e = e + 1; }
    while ((e > v) && ((load8(resp + e - 1) == 32) || (load8(resp + e - 1) == 9))) { e = e - 1; }
    return util_dup_range(resp + v, e - v);
}

# Content-Length value, or -1 if absent/malformed.
fn http_content_length(resp, len): i64 {
    var v = http_header_value(resp, len, "content-length");
    if (v < 0) { return 0 - 1; }
    var n = 0;
    var any = 0;
    var i = v;
    var digits = 0;
    while (i < len) {
        var c = load8(resp + i);
        if ((c < 48) || (c > 57)) { break; }
        digits = digits + 1;
        # A server-supplied Content-Length is attacker-controlled. Past 18
        # digits the multiply wraps i64, and a wrapped-negative length would
        # sail through the "body shorter than promised" comparison.
        if (digits > 18) { return 0 - 1; }
        n = n * 10 + (c - 48);
        any = 1;
        i = i + 1;
    }
    if (any == 0) { return 0 - 1; }
    return n;
}

# --- chunked framing ---

# Parse the chunk-size line at body[i..): hex digits, then skip to the LF that
# ends the line (past any `;ext` and the CR). One parser for every chunked walker,
# so they cannot disagree about where a body ends. Returns the size, or
#   HTTP_CHUNK_BAD    no hex digit, or more than 15 of them;
#   HTTP_CHUNK_SHORT  the line's LF has not arrived yet.
# On success _http_chunk_next is the offset just past that LF.
#
# 0.7.2: the digit count was unbounded. 16 hex digits overflow i64 into a NEGATIVE
# size, and the completeness walk then moved its cursor backwards: an endless
# loop at 100% CPU (FFFFFFFFFFFFFFEC) or a read before the buffer and a SIGSEGV
# (8000000000000000), from any server, on every fetch. 15 digits is 2^60 bytes,
# far past any body whirl can hold.
var HTTP_CHUNK_BAD   = 0 - 1;
var HTTP_CHUNK_SHORT = 0 - 2;
var _HTTP_CHUNK_HEXMAX = 15;
var _http_chunk_next = 0;
fn _http_chunk_size(body, i, blen): i64 {
    var sz = 0;
    var nd = 0;
    while (i < blen) {
        var h = _http_hexval(load8(body + i));
        if (h < 0) { break; }
        nd = nd + 1;
        if (nd > _HTTP_CHUNK_HEXMAX) { return HTTP_CHUNK_BAD; }
        sz = sz * 16 + h;
        i = i + 1;
    }
    if (nd == 0) {
        if (i >= blen) { return HTTP_CHUNK_SHORT; }
        return HTTP_CHUNK_BAD;
    }
    while ((i < blen) && (load8(body + i) != 10)) { i = i + 1; }
    if (i >= blen) { return HTTP_CHUNK_SHORT; }
    _http_chunk_next = i + 1;
    return sz;
}

# Walk the chunks of body[0..blen) from offset `i` without copying. Returns 1 once
# the terminating zero-size chunk is reached, else 0: the stream ran out, or it is
# malformed, which never completes and is reported by the truncation check.
# _http_walk_pos is left at the first chunk still incomplete, so the next
# call resumes there. The cursor only ever moves forward: each step lands past
# the chunk's data and its line end.
var _http_walk_pos = 0;
fn _http_chunk_walk(body, i, blen): i64 {
    while (1 == 1) {
        _http_walk_pos = i;
        var sz = _http_chunk_size(body, i, blen);
        if (sz < 0) { return 0; }
        if (sz == 0) { return 1; }                # terminating chunk: body complete
        var d = _http_chunk_next;
        if (sz > blen - d) { return 0; }          # the chunk's data is not all here
        var k = d + sz;
        while ((k < blen) && (load8(body + k) != 10)) { k = k + 1; }
        if (k >= blen) { return 0; }              # nor the CRLF after it
        i = k + 1;
    }
    return 0;
}

fn _http_hexval(c): i64 {
    if ((c >= 48) && (c <= 57))  { return c - 48; }   # 0-9
    if ((c >= 97) && (c <= 102)) { return c - 87; }   # a-f
    if ((c >= 65) && (c <= 70))  { return c - 55; }   # A-F
    return 0 - 1;
}

# Decode chunked transfer-encoding from `body` into `out`. Returns the decoded
# length, or -1 on malformed input, a chunk cut short, or output overflow.
fn http_dechunk(body, blen, out, outmax): i64 {
    var i = 0;
    var o = 0;
    while (i < blen) {
        var sz = _http_chunk_size(body, i, blen);
        if (sz < 0) { return 0 - 1; }
        i = _http_chunk_next;
        if (sz == 0) { return o; }                # terminating chunk
        if (sz > blen - i) { return 0 - 1; }      # chunk data cut short
        if (sz > outmax - o) { return 0 - 1; }    # would overflow `out`
        var k = 0;
        while (k < sz) { store8(out + o + k, load8(body + i + k)); k = k + 1; }
        o = o + sz;
        i = i + sz;
        # skip the CRLF after the chunk data
        while ((i < blen) && (load8(body + i) != 10)) { i = i + 1; }
        i = i + 1;
    }
    return o;
}

# 1 if Transfer-Encoding contains "chunked", else 0.
fn http_is_chunked(resp, len): i64 {
    var v = http_header_value(resp, len, "transfer-encoding");
    if (v < 0) { return 0; }
    var i = v;
    while (i < len) {
        if (load8(resp + i) == 13) { break; }
        if (util_match_ci(resp, i, len, "chunked") == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# --- has the whole response arrived? ---
#
# The response's own framing is the authority on "it has all arrived", not the
# socket. A chunked body ends at its terminating chunk, a Content-Length body at
# its length; only a close-delimited body (neither) genuinely ends at EOF, and for
# that one the answer stays 0 so the caller keeps reading. (Before 0.6.9 whirl
# read every response to EOF. On AGNOS the peer close is not surfaced promptly,
# so a complete chunked response burned the full 10 s receive deadline and was
# then reported incomplete.)
#
# INCREMENTAL since 0.7.2. The read loop asks after every recv, and the old check
# started from offset 0 each time, both the header-terminator scan and the whole
# chunk walk. A server trickling small chunks made that quadratic: 40,000
# one-byte chunks cost 5.9 s of CPU. The state below remembers how far each scan
# got. http_complete_reset() starts a response; http_complete_feed() is then
# called with the whole buffer so far.
#
# Interim 1xx responses (100 Continue, 103 Early Hints) are skipped. Before 0.7.2
# a 103 was taken as the final response, and the real response's status line and
# headers were emitted as its body. http_complete_base() is where the final
# response starts; the transport moves it to offset 0 before anything else
# parses the buffer. 101 counts as final (whirl never asks to upgrade).
#
# A HEAD response (http_set_no_body), a 204 and a 304 carry no body, so each is
# complete at the end of its headers. Before 0.7.2 a 204 or 304 without a length
# header was read as close-delimited and waited out the receive deadline.
var _http_no_body = 0;
# Mark the next response as bodiless (1 for a HEAD request), so it is complete at
# the end of its headers. Set per request: 0.7.2 stopped it leaking from `-I`
# into the GETs a redirect or a crawl sends.
fn http_set_no_body(v): i64 { _http_no_body = v; return 0; }

var _HC_UNKNOWN = 0;
var _HC_NOBODY  = 1;
var _HC_CHUNKED = 2;
var _HC_LENGTH  = 3;
var _HC_CLOSE   = 4;
var _hc_base = 0;          # start of the final (non-1xx) response
var _hc_scan = 0;          # where the header-terminator scan resumes
var _hc_bo = 0 - 1;        # body offset of the final response; -1 until found
var _hc_kind = 0;
var _hc_cl = 0;
var _hc_ck = 0;            # chunk walk cursor

# Start judging a new response.
fn http_complete_reset(): i64 {
    _hc_base = 0;
    _hc_scan = 0;
    _hc_bo = 0 - 1;
    _hc_kind = _HC_UNKNOWN;
    _hc_cl = 0;
    _hc_ck = 0;
    return 0;
}

# Offset of the final response in the buffer last fed (after any 1xx).
fn http_complete_base(): i64 { return _hc_base; }

# Is resp[0..len) a COMPLETE response yet? `resp` must be the same buffer, grown,
# since the last http_complete_reset().
fn http_complete_feed(resp, len): i64 {
    while (_hc_bo < 0) {
        var i = _hc_scan;
        if (i < _hc_base) { i = _hc_base; }
        var found = 0 - 1;
        while ((i + 3 < len) && (found < 0)) {
            if ((load8(resp + i) == 13) && (load8(resp + i + 1) == 10)
                && (load8(resp + i + 2) == 13) && (load8(resp + i + 3) == 10)) { found = i; }
            else { i = i + 1; }
        }
        if (found < 0) { _hc_scan = i; return 0; }   # headers not finished; resume at i
        var head_end = found + 4;
        var h = resp + _hc_base;
        var hlen = head_end - _hc_base;
        var st = http_status_code(h, hlen);
        if ((st >= 100) && (st < 200) && (st != 101)) {
            _hc_base = head_end;                  # interim response: skip it
            _hc_scan = head_end;
        } else {
            _hc_bo = head_end;
            if ((_http_no_body == 1) || (st == 204) || (st == 304) || (st == 101)) { _hc_kind = _HC_NOBODY; }
            elif (http_is_chunked(h, hlen) == 1) { _hc_kind = _HC_CHUNKED; _hc_ck = head_end; }
            else {
                _hc_cl = http_content_length(h, hlen);
                if (_hc_cl >= 0) { _hc_kind = _HC_LENGTH; } else { _hc_kind = _HC_CLOSE; }
            }
        }
    }
    if (_hc_kind == _HC_NOBODY) { return 1; }
    if (_hc_kind == _HC_LENGTH) {
        if ((len - _hc_bo) >= _hc_cl) { return 1; }
        return 0;
    }
    if (_hc_kind == _HC_CHUNKED) {
        var done = _http_chunk_walk(resp, _hc_ck, len);
        _hc_ck = _http_walk_pos;
        return done;
    }
    return 0;                                     # close-delimited: only EOF ends it
}

# Stateless form: is resp[0..len) a complete response?
fn http_response_complete(resp, len): i64 {
    http_complete_reset();
    return http_complete_feed(resp, len);
}

# Is this response short of what it promised? 1 = the transfer must be treated as
# failed. `incomplete` is transport_incomplete(): the read ended on an error or a
# full buffer, not a clean close. Asked of EVERY response: a server that sends
# fewer bytes than its Content-Length and then closes cleanly looks like an
# ordinary EOF to the read loop.
#
# 0.7.2: a header block that never ended counts as truncated. It counted as
# complete, so `-i` and `-I` wrote a half header block and exited 0.
fn http_response_truncated(resp, len, incomplete): i64 {
    if (http_response_complete(resp, len) == 1) { return 0; }
    if (_hc_bo < 0) { return 1; }                 # the header block never ended
    if (_hc_kind == _HC_CHUNKED) { return 1; }    # chunk stream never terminated
    if (_hc_kind == _HC_LENGTH) { return 1; }     # short of the promised length
    return incomplete;                            # close-delimited
}

# Decode the body of a complete response. Returns its length and stores a pointer
# to the bytes at `outp`: resp itself for a Content-Length or close-delimited body
# (clamped to the length), `scratch` for a chunked one. Returns -1 for a chunked
# body that does not decode, -2 when the header block never ended. The one decode
# path: before 0.7.2 three copies existed, and the -C 206 append and the
# robots.txt fetch had none, so they consumed raw chunk framing.
fn http_decode_body(resp, len, scratch, scratchmax, outp): i64 {
    var bo = http_body_offset(resp, len);
    if (bo < 0) { return 0 - 2; }
    var blen = len - bo;
    if (http_is_chunked(resp, len) == 1) {
        var dn = http_dechunk(resp + bo, blen, scratch, scratchmax);
        if (dn < 0) { return 0 - 1; }
        store64(outp, scratch);
        return dn;
    }
    var cl = http_content_length(resp, len);
    if ((cl >= 0) && (cl < blen)) { blen = cl; }
    store64(outp, resp + bo);
    return blen;
}

# Parse "Content-Range: bytes FIRST-LAST/TOTAL" (TOTAL may be '*'), or the 416
# form "bytes */TOTAL". Returns 1 and sets http_cr_first / http_cr_total (-1 for
# '*'), or 0 when the header is absent or malformed.
var _http_cr_first = 0 - 1;
var _http_cr_total = 0 - 1;
# First byte of the last parsed Content-Range, or -1 ("*/N" form).
fn http_cr_first(): i64 { return _http_cr_first; }
# Complete length of the last parsed Content-Range, or -1 ("/*").
fn http_cr_total(): i64 { return _http_cr_total; }

# Decimal at resp[i..len), at most 18 digits. Returns the value, with the end in
# _http_num_end; -1 when there is no digit.
var _http_num_end = 0;
fn _http_num(resp, i, len): i64 {
    var n = 0;
    var d = 0;
    while ((i < len) && (load8(resp + i) >= 48) && (load8(resp + i) <= 57)) {
        d = d + 1;
        if (d > 18) { return 0 - 1; }
        n = n * 10 + (load8(resp + i) - 48);
        i = i + 1;
    }
    _http_num_end = i;
    if (d == 0) { return 0 - 1; }
    return n;
}

# Parse the response's Content-Range into http_cr_first / http_cr_total (see above).
fn http_content_range(resp, len): i64 {
    _http_cr_first = 0 - 1;
    _http_cr_total = 0 - 1;
    var v = http_header_value(resp, len, "content-range");
    if (v < 0) { return 0; }
    if (util_match_ci(resp, v, len, "bytes ") == 0) { return 0; }
    var i = v + 6;
    if ((i < len) && (load8(resp + i) == 42)) {           # "*/TOTAL" (416)
        i = i + 1;
    } else {
        var first = _http_num(resp, i, len);
        if (first < 0) { return 0; }
        i = _http_num_end;
        if ((i >= len) || (load8(resp + i) != 45)) { return 0; }   # '-'
        var last = _http_num(resp, i + 1, len);
        if (last < first) { return 0; }
        i = _http_num_end;
        _http_cr_first = first;
    }
    if ((i >= len) || (load8(resp + i) != 47)) { return 0; }       # '/'
    i = i + 1;
    if ((i < len) && (load8(resp + i) == 42)) { return 1; }        # unknown total
    var total = _http_num(resp, i, len);
    if (total < 0) { return 0; }
    _http_cr_total = total;
    return 1;
}

# 1 for a method RFC 9110 §9.2.2 calls idempotent: sending it twice has the effect
# of sending it once, so it is safe to retry after the request went out.
fn http_method_idempotent(m): i64 {
    if (util_streq_ci(m, "GET") == 1) { return 1; }
    if (util_streq_ci(m, "HEAD") == 1) { return 1; }
    if (util_streq_ci(m, "OPTIONS") == 1) { return 1; }
    if (util_streq_ci(m, "TRACE") == 1) { return 1; }
    if (util_streq_ci(m, "PUT") == 1) { return 1; }
    if (util_streq_ci(m, "DELETE") == 1) { return 1; }
    return 0;
}

