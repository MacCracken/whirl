# whirl — URL parser (http / https — the MVP transfer surface).
#
# Packs into a 32-byte struct:
#   [0]  is_https (i64, 0/1)
#   [8]  port     (i64)
#   [16] host     (cstr ptr, freshly alloc'd)
#   [24] path     (cstr ptr, freshly alloc'd; defaults to "/")
#
# Pure logic — no I/O. Stdlib auto-included via cyrius.cyml.

var URL_OFF_HTTPS = 0;
var URL_OFF_PORT  = 8;
var URL_OFF_HOST  = 16;
var URL_OFF_PATH  = 24;
var URL_STRUCT_SZ = 32;

var URL_PARSE_OK   = 0;
var URL_PARSE_FAIL = 0 - 1;

# Allocate a zeroed URL struct (URL_STRUCT_SZ bytes) for url_parse to fill.
fn url_new(): i64 {
    var u = xalloc(URL_STRUCT_SZ);
    store64(u + URL_OFF_HTTPS, 0);
    store64(u + URL_OFF_PORT, 0);
    store64(u + URL_OFF_HOST, 0);
    store64(u + URL_OFF_PATH, 0);
    return u;
}

# 1 for an https:// URL, 0 for http://.
fn url_is_https(u): i64 { return load64(u + URL_OFF_HTTPS); }
# The port: explicit, or the scheme default (80 / 443).
fn url_port(u): i64     { return load64(u + URL_OFF_PORT); }
# The host (cstr).
fn url_host(u): i64     { return load64(u + URL_OFF_HOST); }
# The path (cstr); "/" when the URL has none.
fn url_path(u): i64     { return load64(u + URL_OFF_PATH); }

# Derive a download filename from a path (cstr): the last '/'-segment with any
# `?query` or `#fragment` stripped, or "index.html" when the path is "/" or ends
# in "/". Returns a fresh cstr.
fn url_filename(path): i64 {
    var n = strlen(path);
    # cut at the first '?' (63) or '#' (35)
    var end = 0;
    while ((end < n) && (load8(path + end) != 63) && (load8(path + end) != 35)) { end = end + 1; }
    # last '/' (47) within [0, end)
    var lastslash = 0 - 1;
    var i = 0;
    while (i < end) {
        if (load8(path + i) == 47) { lastslash = i; }
        i = i + 1;
    }
    var s = lastslash + 1;
    var slen = end - s;
    if (slen <= 0) { return util_dup_range("index.html", 10); }
    return util_dup_range(path + s, slen);
}

# 1 if the `len` bytes at `s` are safe to place in a request line or a Host
# header: no controls, no space, no DEL. RFC 9110 forbids all of them in a
# request target, and whirl writes host/path into the request UNESCAPED — so a
# bare LF in a redirect `Location:` (copied up to the CR or LF) would
# otherwise splice attacker-chosen header lines, or a whole second request, into
# the request sent to the redirect TARGET. Validating here covers every source
# of a URL at once: the command line, `Location:`, and crawled hrefs.
# High bytes (>= 128) are left alone so UTF-8 / IDN paths still parse.
fn _url_bytes_clean(s, len): i64 {
    var i = 0;
    while (i < len) {
        var c = load8(s + i);
        if ((c >= 0) && (c <= 32)) { return 0; }   # CTL + space
        if (c == 127) { return 0; }                # DEL
        i = i + 1;
    }
    return 1;
}

# Parse `len` decimal digits at `s` → value, or -1 on any non-digit / empty.
fn _url_parse_uint(s, len): i64 {
    if (len <= 0) { return 0 - 1; }
    # Bail before the multiply can wrap. A long digit run overflowed i64 and
    # could land back in 1..65535, defeating the caller's port range check —
    # ":18446744073709551696" parsed as port 80.
    if (len > 10) { return 0 - 1; }
    var v = 0;
    var i = 0;
    while (i < len) {
        var c = load8(s + i);
        if ((c < 48) || (c > 57)) { return 0 - 1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

# 1 if `c` ends the authority: '/', '?', '#' or the terminating NUL (RFC 3986 §3.2).
fn _url_authority_end(c): i64 {
    if ((c == 0) || (c == 47) || (c == 63) || (c == 35)) { return 1; }
    return 0;
}

# Parse `url` (cstr) into the struct `u` (from url_new).
# Returns URL_PARSE_OK / URL_PARSE_FAIL.
#
# The scheme is matched case-insensitively (RFC 3986 §3.1), so a redirect to
# `HTTPS://…` is followed. The authority ends at '/', '?' or '#'. Before 0.7.2
# only '/' ended it, so `http://h?x=1` parsed with the host "h?x=1". A
# `#fragment` is dropped: RFC 9110 §7.1 keeps it client-side. Before 0.7.2 it
# went out in the request line, and `-r` saved `p.html#a` and `p.html#b` as two
# files, each fetched separately against the 64-resource cap. A path that starts
# with '?' gains a leading '/'.
fn url_parse(url, u): i64 {
    var p = url;
    var is_https = 0;
    var defport = 80;
    if (util_has_prefix_ci(p, "https://") == 1) {
        is_https = 1; defport = 443; p = p + 8;
    } else {
        if (util_has_prefix_ci(p, "http://") == 1) {
            is_https = 0; defport = 80; p = p + 7;
        } else {
            return URL_PARSE_FAIL;
        }
    }

    var hostlen = 0;
    while (_url_authority_end(load8(p + hostlen)) == 0) { hostlen = hostlen + 1; }
    if (hostlen == 0) { return URL_PARSE_FAIL; }

    # find ':' (58) within the authority
    var colon = 0 - 1;
    var i = 0;
    while (i < hostlen) {
        if (load8(p + i) == 58) { colon = i; }
        i = i + 1;
    }

    var host_end = hostlen;
    var port = defport;
    if (colon >= 0) {
        host_end = colon;
        port = _url_parse_uint(p + colon + 1, hostlen - colon - 1);
        if (port <= 0)    { return URL_PARSE_FAIL; }
        if (port > 65535) { return URL_PARSE_FAIL; }
    }
    if (host_end == 0) { return URL_PARSE_FAIL; }
    if (_url_bytes_clean(p, host_end) == 0) { return URL_PARSE_FAIL; }

    var host = util_dup_range(p, host_end);

    # Path (and query) run to the '#' or the end; the fragment is not kept.
    var q = p + hostlen;
    var pl = 0;
    while ((load8(q + pl) != 0) && (load8(q + pl) != 35)) { pl = pl + 1; }
    if (_url_bytes_clean(q, pl) == 0) { return URL_PARSE_FAIL; }
    var path = 0;
    if (pl == 0) { path = util_dup_range("/", 1); }
    elif (load8(q) == 63) { path = util_concat2("/", util_dup_range(q, pl)); }   # "?x" -> "/?x"
    else { path = util_dup_range(q, pl); }

    store64(u + URL_OFF_HTTPS, is_https);
    store64(u + URL_OFF_PORT, port);
    store64(u + URL_OFF_HOST, host);
    store64(u + URL_OFF_PATH, path);
    return URL_PARSE_OK;
}
