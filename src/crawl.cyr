# whirl — crawl logic: link resolution, path confinement, robots.txt.
#
# Pure buffer/string logic — no I/O, no network, no filesystem. Carved out of
# main.cyr at 0.6.7 so it can be reached from tests/whirl.tcyr: this is where
# the 0.6.6 security fixes live (path confinement, origin comparison, absolute
# URL resolution), and while it sat inside main.cyr the only way to exercise it
# was end-to-end through a real binary and a real server. The I/O halves —
# _save_tree's mkdir/write, _robots_load's fetch, _crawl itself — stay in
# main.cyr.
#
# Depends on links.cyr (links_path_normalize); include it first.

fn _starts(s, pfx): i64 {
    var i = 0;
    while (load8(pfx + i) != 0) {
        if (load8(s + i) != load8(pfx + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ':' before any '/' → a non-http scheme (mailto:, javascript:, tel:, data:).
fn _has_scheme_colon(s): i64 {
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c == 58) { return 1; }
        if (c == 47) { return 0; }
        i = i + 1;
    }
    return 0;
}

# Same origin = same scheme, host (case-insensitive) and port.
fn _ci_streq(a, b): i64 {
    var i = 0;
    while (1 == 1) {
        var x = load8(a + i);
        var y = load8(b + i);
        if ((x >= 65) && (x <= 90)) { x = x + 32; }
        if ((y >= 65) && (y <= 90)) { y = y + 32; }
        if (x != y) { return 0; }
        if (x == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _concat2(a, b): i64 {
    var la = strlen(a);
    var lb = strlen(b);
    var d = alloc(la + lb + 1);
    var i = 0;
    while (i < la) { store8(d + i, load8(a + i)); i = i + 1; }
    var j = 0;
    while (j < lb) { store8(d + la + j, load8(b + j)); j = j + 1; }
    store8(d + la + lb, 0);
    return d;
}

# Directory part of a path including the trailing slash ("/a/b.html" -> "/a/").
fn _path_dir(path): i64 {
    var n = strlen(path);
    var lastslash = 0;
    var i = 0;
    while (i < n) { if (load8(path + i) == 47) { lastslash = i; } i = i + 1; }
    var d = alloc(lastslash + 2);
    var k = 0;
    while (k <= lastslash) { store8(d + k, load8(path + k)); k = k + 1; }
    store8(d + lastslash + 1, 0);
    return d;
}

# 1 if `len` bytes of `path` are safe to mirror under cwd — i.e. no ".."
# segment. A crawled page controls these bytes, and _save_tree turns them into a
# filesystem path, so an unchecked "/../../../../home/user/.bashrc" (which
# _resolve_link passes through verbatim for absolute same-host links) is a
# remote arbitrary-file-write. Checked here, at the single point that touches
# the filesystem, rather than trusting any particular caller to normalize.
fn _path_no_dotdot(path, len): i64 {
    var i = 0;
    while (i < len) {
        var seg = i;
        while ((i < len) && (load8(path + i) != 47)) { i = i + 1; }
        if (((i - seg) == 2) && (load8(path + seg) == 46) && (load8(path + seg + 1) == 46)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# "host" or "host:port" — the authority to rebuild an absolute URL with. The
# port must survive: dropping it turned every redirect on a non-default port
# into a request to :80/:443.
fn _authority(host, is_https, port): i64 {
    var defport = 80;
    if (is_https == 1) { defport = 443; }
    if (port == defport) { return host; }
    var tmp[24];
    var nl = fmt_int_buf(port, &tmp);
    var lh = strlen(host);
    var d = alloc(lh + nl + 2);
    var i = 0;
    while (i < lh) { store8(d + i, load8(host + i)); i = i + 1; }
    store8(d + lh, 58);                                   # ':'
    var k = 0;
    while (k < nl) { store8(d + lh + 1 + k, load8(&tmp + k)); k = k + 1; }
    store8(d + lh + 1 + nl, 0);
    return d;
}

# Resolve a raw link against the base → full URL cstr, or 0 to skip (fragment /
# non-http scheme). Absolute links pass through (host filtered in _crawl).
fn _resolve_link(link, base_https, base_host, base_port, base_path): i64 {
    var c0 = load8(link);
    if (c0 == 0) { return 0; }
    if (c0 == 35) { return 0; }                      # '#'
    if (_starts(link, "http://") == 1) { return link; }
    if (_starts(link, "https://") == 1) { return link; }
    if (_has_scheme_colon(link) == 1) { return 0; }  # mailto:/javascript:/...
    if ((c0 == 47) && (load8(link + 1) == 47)) {     # protocol-relative //host/path
        var sch = "http:";
        if (base_https == 1) { sch = "https:"; }
        return _concat2(sch, link);                  # → absolute (cross-host filtered later)
    }
    var pfx = "http://";
    if (base_https == 1) { pfx = "https://"; }
    # _authority, not base_host: a bare host dropped a non-default port, so on
    # e.g. :8080 every relative link resolved to :80 and the crawl fetched the
    # wrong service (or nothing) — -r was unusable off the default ports.
    var auth = _authority(base_host, base_https, base_port);
    if (c0 == 47) {                                                      # root-relative
        return _concat2(_concat2(pfx, auth), links_path_normalize(link));
    }
    var dir = _path_dir(base_path);                                      # relative
    var np = links_path_normalize(_concat2(dir, link));
    return _concat2(_concat2(pfx, auth), np);
}

# Resolve a `Location:` value against the current request into an absolute URL.
# RFC 9110 permits a relative Location and real sites use one (a bare "/docs/"
# is common); whirl previously handed it straight to url_parse, which rejects
# anything without a scheme — so -L silently stopped following and exited 0 with
# the redirect stub as the "result". Mirrors _resolve_link's shape, but keeps
# the port, which _resolve_link drops.
fn _abs_location(loc, is_https, host, port, path): i64 {
    if (_starts(loc, "http://") == 1) { return loc; }
    if (_starts(loc, "https://") == 1) { return loc; }
    var sch = "http:";
    if (is_https == 1) { sch = "https:"; }
    if ((load8(loc) == 47) && (load8(loc + 1) == 47)) { return _concat2(sch, loc); }   # //host/path
    if (_has_scheme_colon(loc) == 1) { return 0; }        # mailto:/javascript:/...
    var pfx = "http://";
    if (is_https == 1) { pfx = "https://"; }
    var base = _concat2(pfx, _authority(host, is_https, port));
    if (load8(loc) == 47) { return _concat2(base, links_path_normalize(loc)); }        # root-relative
    return _concat2(base, links_path_normalize(_concat2(_path_dir(path), loc)));       # relative
}

fn _same_origin(is_https, host, port, u2): i64 {
    if (is_https != url_is_https(u2)) { return 0; }
    if (port != url_port(u2)) { return 0; }
    if (_ci_streq(host, url_host(u2)) == 0) { return 0; }
    return 1;
}

fn _seen(visited, nvis, url): i64 {
    var i = 0;
    while (i < nvis) {
        if (streq(load64(visited + i * 8), url) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _robots_ci(body, p, e, lit): i64 {
    var k = 0;
    while (load8(lit + k) != 0) {
        if (p + k >= e) { return 0; }
        var c = load8(body + p + k);
        if ((c >= 65) && (c <= 90)) { c = c + 32; }
        if (c != load8(lit + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

fn _robots_value(body, start, e): i64 {
    var p = start;
    while ((p < e) && (load8(body + p) == 32)) { p = p + 1; }
    return p;
}

# Copy body[v..e) into a fresh cstr; returns it (or 0 if empty).
fn _robots_dup(body, v, e): i64 {
    var vlen = e - v;
    if (vlen <= 0) { return 0; }
    var d = alloc(vlen + 1);
    var k = 0;
    while (k < vlen) { store8(d + k, load8(body + v + k)); k = k + 1; }
    store8(d + vlen, 0);
    return d;
}

# Parse robots body → path-prefix rules for `User-agent: *`. `rules[i]` holds the
# prefix cstr; `flags[i]` = 1 for Allow, 0 for Disallow. Returns the rule count.
fn _robots_parse(body, len, rules, flags, rulesmax): i64 {
    var n = 0;
    var applies = 0;
    var i = 0;
    while (i < len) {
        var s = i;
        while ((i < len) && (load8(body + i) != 10)) { i = i + 1; }
        var e = i;
        if ((e > s) && (load8(body + e - 1) == 13)) { e = e - 1; }   # trim \r
        var p = s;
        while ((p < e) && (load8(body + p) == 32)) { p = p + 1; }
        if ((p < e) && (load8(body + p) != 35)) {                    # not '#'
            if (_robots_ci(body, p, e, "user-agent:") == 1) {
                var v = _robots_value(body, p + 11, e);
                applies = 0;
                if ((v < e) && (load8(body + v) == 42)) { applies = 1; }   # '*'
            }
            elif (_robots_ci(body, p, e, "disallow:") == 1) {
                if ((applies == 1) && (n < rulesmax)) {
                    var d = _robots_dup(body, _robots_value(body, p + 9, e), e);
                    if (d != 0) { store64(rules + n * 8, d); store64(flags + n * 8, 0); n = n + 1; }
                }
            }
            elif (_robots_ci(body, p, e, "allow:") == 1) {
                if ((applies == 1) && (n < rulesmax)) {
                    var a = _robots_dup(body, _robots_value(body, p + 6, e), e);
                    if (a != 0) { store64(rules + n * 8, a); store64(flags + n * 8, 1); n = n + 1; }
                }
            }
        }
        i = i + 1;
    }
    return n;
}

# Is `path` blocked? Longest-matching prefix wins (RFC 9309 specificity); a tie
# resolves to Allow. No match → allowed.
fn _robots_blocked(path, rules, flags, nrules): i64 {
    var best_len = -1;
    var best_allow = 0;
    var i = 0;
    while (i < nrules) {
        var r = load64(rules + i * 8);
        if (_starts(path, r) == 1) {
            var rl = strlen(r);
            if (rl > best_len) { best_len = rl; best_allow = load64(flags + i * 8); }
            elif (rl == best_len) {
                if (load64(flags + i * 8) == 1) { best_allow = 1; }   # tie → Allow wins
            }
        }
        i = i + 1;
    }
    if (best_len < 0) { return 0; }      # nothing matched → allowed
    if (best_allow == 1) { return 0; }   # most-specific rule is Allow
    return 1;                            # most-specific rule is Disallow
}

# Map a URL path to the relative on-disk path -r mirrors it to, or 0 if the path
# is not safe to write. This is the confinement boundary from 0.6.6, split out
# of _save_tree so it can be tested directly:
#   - any ".." segment is refused outright (0), and
#   - EVERY leading '/' is stripped, so "//tmp/x" cannot survive as the absolute
#     path "/tmp/x" the way it did when only one slash was removed.
# "/docs/g.html" -> "docs/g.html"; "/" or "/d/" gain "index.html"; "?query" is cut.
fn tree_relpath(path): i64 {
    var n = strlen(path);
    var end = 0;
    while ((end < n) && (load8(path + end) != 63)) { end = end + 1; }   # strip ?query
    if (_path_no_dotdot(path, end) == 0) { return 0; }
    var rp = alloc(end + 12);
    var w = 0;
    var i = 0;
    while ((i < end) && (load8(path + i) == 47)) { i = i + 1; }
    while (i < end) { store8(rp + w, load8(path + i)); w = w + 1; i = i + 1; }
    var need_index = 0;
    if (w == 0) { need_index = 1; }
    elif (load8(rp + w - 1) == 47) { need_index = 1; }
    if (need_index == 1) {
        var idx = "index.html";
        var m = 0;
        while (load8(idx + m) != 0) { store8(rp + w, load8(idx + m)); w = w + 1; m = m + 1; }
    }
    store8(rp + w, 0);
    return rp;
}
