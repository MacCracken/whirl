# whirl — the version string, in one place.
#
# CLAUDE.md makes the root `VERSION` file the source of truth. Cyrius has no
# build-time define to inject it, so the value is mirrored here — ONE literal,
# not one per call site — and CI asserts this file agrees with `VERSION`
# (.github/workflows/ci.yml, "Verify version consistency"). Before 0.6.8 the
# only copy lived inline in the User-Agent, where it went stale for six
# releases before anyone noticed.
var WHIRL_VERSION = "0.6.10";
