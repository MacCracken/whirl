# whirl — write the response body to stdout or a file.
#
# Stdlib auto-included via cyrius.cyml (syscalls: sys_write; io: file_write_all).
#
# 0.6.8: the Linux arms below used bare syscall NUMBERS (2/1/3/8) and a bare
# flag word (1089) where the rest of whirl uses the `sys_*` wrappers and the
# io.cyr O_* constants. Same instructions, but the numbers said nothing about
# what they did and could not be checked against the enums that define them.

var SEEK_END = 2;

# O_NOFOLLOW is not exported by lib/syscalls_*.cyr — sigil writes it numerically
# inline and says so (lib/sigil.cyr:3521). Its Linux value is ARCH-dependent, so
# it is defined per-arch here rather than copied as sigil's x86_64 literal:
#   x86_64  0400000 = 131072
#   aarch64 0100000 =  32768
# Getting this wrong would not fail loudly — it would pass some *other* flag and
# silently drop the no-follow guarantee, which is the whole point of the call.
#ifdef CYRIUS_ARCH_AARCH64
var O_NOFOLLOW = 32768;
#endif
#ifndef CYRIUS_ARCH_AARCH64
var O_NOFOLLOW = 131072;
#endif

# Write `len` bytes to stdout (outfile == 0) or to `outfile` (created/truncated).
# Returns 0 on success, < 0 on a file error.
fn output_write(buf, len, outfile): i64 {
    if (outfile == 0) {
        sys_write(1, buf, len);
        return 0;
    }
    var r = file_write_all(outfile, buf, len);
    if (r < 0) { return r; }
    return 0;
}

# Append `len` bytes to `outfile` (created if absent) — for -C resume after a
# 206 Partial Content. Linux uses true O_APPEND (no size cap). agnos has no
# O_APPEND/flock in the frozen FS surface, so it read-modify-writes the file
# (≤1 MB resume cap there — fine for the MVP).
fn output_append(buf, len, outfile): i64 {
#ifndef CYRIUS_TARGET_AGNOS
    var fd = sys_open(outfile, O_WRONLY | O_APPEND | O_CREAT, 420);   # 0644
    if (fd < 0) { return fd; }
    var w = sys_write(fd, buf, len);
    sys_close(fd);
    if (w < 0) { return w; }
    return 0;
#endif
#ifdef CYRIUS_TARGET_AGNOS
    # Read-modify-write, because the frozen agnos FS surface has no O_APPEND.
    # That makes the read cap load-bearing: a file LARGER than the cap used to
    # be read to `cap` bytes and then written back at cap+len, silently
    # DESTROYING everything past the cap — a -C resume that ate the download it
    # was resuming. Refuse instead; the caller reports it.
    var cap = 1048576;
    if (output_file_size(outfile) > cap) { return 0 - 1; }
    var old = xalloc(cap);
    var on = file_read_all(outfile, old, cap);
    if (on < 0) { on = 0; }
    var merged = xalloc(on + len);
    var i = 0;
    while (i < on)  { store8(merged + i, load8(old + i)); i = i + 1; }
    var j = 0;
    while (j < len) { store8(merged + on + j, load8(buf + j)); j = j + 1; }
    # Normalize to the documented contract: 0 on success, < 0 on error.
    # file_write_all returns the BYTE COUNT, so returning it raw made the agnos
    # arm answer 8 where the Linux arm answers 0 for the same success. No caller
    # is broken by it today (main.cyr tests `< 0`), but the two arms disagreeing
    # about their own contract is exactly what a future `== 0` check would trip
    # over. Found by tests/agnos_probe.cyr — the arm had never been executed.
    var wr = file_write_all(outfile, merged, on + len);
    if (wr < 0) { return wr; }
    return 0;
#endif
}

# Size of an existing file, or 0 if missing/empty (for -C resume offset). The
# targets diverge: Linux lseek(SEEK_END) vs agnos sys_stat (STAT_SIZE=16).
fn output_file_size(path): i64 {
#ifndef CYRIUS_TARGET_AGNOS
    var fd = sys_open(path, O_RDONLY, 0);
    if (fd < 0) { return 0; }
    var sz = syscall(SYS_LSEEK, fd, 0, SEEK_END);
    sys_close(fd);
    if (sz < 0) { return 0; }
    return sz;
#endif
#ifdef CYRIUS_TARGET_AGNOS
    var nl = 0;
    while (load8(path + nl) != 0) { nl = nl + 1; }
    var sb = xalloc(STAT_BUFSZ);
    if (sys_stat(path, nl, sb) < 0) { return 0; }
    return load64(sb + STAT_SIZE);
#endif
}

var _fs_link_buf = 0;   # readlink scratch, allocated once (see fs_is_symlink)

# Write buf[0..len) to `path`, refusing to follow a symlink at the FINAL path
# component. Returns 0, or < 0.
#
# This exists to close the check-then-write race that `fs_is_symlink` + a plain
# write leaves open: between the check and the open, anything that can write to
# the directory can replace the path with a symlink, and the write lands wherever
# it points. `-r` writes many files into a directory whirl does not own, so the
# attacker gets unlimited retries.
#
# LINUX: closed properly — `O_NOFOLLOW` makes the refusal part of the open
# itself, so there is no window. The kernel returns -ELOOP when the final
# component is a link, and that includes a DANGLING link, which a plain
# `O_CREAT` would otherwise happily create at the attacker's chosen path.
#
# AGNOS: cannot be closed here — `open`(7) has no no-follow flag (and no
# O_EXCL either), so the pre-check is still the best available and the race
# remains. Filed as agnos issue 2026-08-27-open-ao-nofollow-flag; the kernel
# already has the machinery (`ext2_path_lookup_ex(..., follow_last=0)`, used by
# readlink#70) and the ask is to expose it on open.
#
# ⚠ RESIDUAL on both targets: O_NOFOLLOW guards only the FINAL component, which
# is POSIX's semantics and agnos readlink#70's too ("mid-path symlinks still
# resolve"). A symlinked *intermediate directory* inside the output tree is still
# followed. `tree_relpath` already rejects `..` segments, so reaching that state
# requires planting a symlinked directory in the crawl output — narrower than the
# final-component case this closes, and not claimed as covered.
fn fs_write_no_follow(path, buf, len): i64 {
#ifndef CYRIUS_TARGET_AGNOS
    var fd = sys_open(path, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW, 420);   # 0644
    if (fd < 0) { return fd; }          # -ELOOP if the final component is a link
    var off = 0;
    while (off < len) {
        var w = sys_write(fd, buf + off, len - off);
        if (w <= 0) { sys_close(fd); return 0 - 1; }
        off = off + w;
    }
    sys_close(fd);
    return 0;
#endif
#ifdef CYRIUS_TARGET_AGNOS
    # Racy by necessity — see the note above.
    if (fs_is_symlink(path) == 1) { return 0 - 1; }
    var wr = file_write_all(path, buf, len);
    if (wr < 0) { return wr; }
    return 0;
#endif
}

# Is `path` an existing symlink? `-r` would otherwise follow it and write THROUGH
# it, so a symlink planted in the crawl directory redirects a mirrored file
# anywhere the user can write — the same outcome as the 0.6.6 traversal bug by a
# different route.
#
# Implemented on BOTH targets as of 0.6.12 — Linux via lstat, agnos via
# readlink#70. The earlier claim that agnos "cannot express" this check was
# wrong: it was true only of stat#33, and the kernel had already shipped the
# no-follow primitive that answers it.
#
# A pre-write lstat is also TOCTOU-racy against an attacker who can create the
# link between the check and the open. Closing that needs O_NOFOLLOW on the
# write itself, which means bypassing file_write_all — out of scope here. This
# still removes the whole class of pre-planted-symlink cases.
fn fs_is_symlink(path): i64 {
#ifndef CYRIUS_TARGET_AGNOS
    var sb = xalloc(STAT_BUFSZ);
    if (sys_lstat(path, sb) < 0) { return 0; }       # missing → nothing to follow
    var mode = load64(sb + STAT_MODE) & 0xFFFFFFFF;  # st_mode is a u32 field
    if ((mode & 0xF000) == 0xA000) { return 1; }     # S_IFLNK
    return 0;
#endif
#ifdef CYRIUS_TARGET_AGNOS
    # agnos has no lstat, and stat#33 follows the final component — but it does
    # not need one. readlink#70 resolves the FINAL component NO-FOLLOW and
    # returns -1 when that component is not a symlink, so success IS the
    # detection. The ABI picked it over an lstat variant of #33 deliberately
    # ("readlink alone gives a symlink manager BOTH what it needs — detect and
    # the target text — in one call"), and cyrius ships the sys_readlink peer.
    #
    # The scratch buffer is allocated once and reused: this runs per saved file
    # in a crawl, and the allocator is a bump allocator with no free. One block
    # is the kernel's own ceiling for a symlink target (ext2: fast-inline < 60
    # bytes, else exactly one block), so a real target can never be truncated
    # into a false "not a symlink".
    if (_fs_link_buf == 0) { _fs_link_buf = xalloc(4096); }
    if (sys_readlink(path, strlen(path), _fs_link_buf, 4096) >= 0) { return 1; }
    return 0;   # -1 = not a symlink, absent, or not an ext2 mount
#endif
}
