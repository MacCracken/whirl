# whirl — transport: resolve + TCP connect + send + recv (plain HTTP).
#
# Composes the taar substrate: taar_resolve_ipv4 (DNS over UDP-53) + taar's TCP
# socket primitives (taar_tcp_open / connect / send / recv / close). Sovereign,
# raw-syscall — no lib/net.cyr. HTTPS (the tls_native wrap over this socket) is
# the next bite.
#
# taar is included via lib/taar.cyr (the [deps.taar] dist bundle).

var TRANSPORT_ERR_RESOLVE = 0 - 2;
var TRANSPORT_ERR_SOCKET  = 0 - 3;
var TRANSPORT_ERR_CONNECT = 0 - 4;
var TRANSPORT_ERR_TLS     = 0 - 5;
var TRANSPORT_ERR_SEND    = 0 - 6;

# Set by every transport_fetch*: 1 when the read loop ended on a socket/TLS
# ERROR or on filling rbuf, rather than on a clean peer close. Both loops used
# to fold `n < 0` into the same branch as `n == 0`, so a mid-body timeout or RST
# returned `total` as a SUCCESSFUL fetch and whirl wrote a truncated file with
# exit 0. taar 0.5.0 separates the two on purpose (_TAAR_ERR_TIMEOUT = -11 vs 0
# for a clean close) — this flag carries that distinction up to the caller,
# which cross-checks it against Content-Length before trusting the bytes.
# A flag rather than an error return: a peer that RSTs after sending a complete
# Content-Length-delimited body is common, and must not become a hard failure.
var _transport_incomplete = 0;
fn transport_incomplete(): i64 { return _transport_incomplete; }

# Send all of `len` bytes. taar_tcp_send is write(2) on Linux and sock_send#48
# on agnos; BOTH document a short write ("bytes accepted, which may be < len —
# the caller loops"), and the old call discarded the return entirely, so an
# oversized -d body could be sent truncated under a Content-Length that promised
# more. 0 is a legal transient (full tx buffer), so it is tolerated with a
# bounded spin rather than treated as fatal — the same shape as taar's own
# _taar_dns_tcp_send_all. Returns 0, or TRANSPORT_ERR_SEND.
var _TRANSPORT_SEND_SPIN_MAX = 1000;
fn _transport_send_all(fd, buf, len): i64 {
    var off = 0;
    var spin = 0;
    while (off < len) {
        var w = taar_tcp_send(fd, buf + off, len - off);
        if (w < 0) { return TRANSPORT_ERR_SEND; }
        if (w == 0) {
            spin = spin + 1;
            if (spin > _TRANSPORT_SEND_SPIN_MAX) { return TRANSPORT_ERR_SEND; }
        } else {
            spin = 0;
            off = off + w;
        }
    }
    return 0;
}

# The response read loop, shared by both fetch paths. It exists once because
# the policy in it is subtle and was previously duplicated: the two copies had
# to be fixed in lockstep when error-vs-EOF conflation was found, and a third
# consumer would have had to remember. `mode` selects the reader with a direct
# call rather than a function pointer — the AGNOS arm has no executed test
# coverage, so this keeps its hot path on the same mechanism it already ships.
#   mode 0 = plain socket (handle = fd), mode 1 = TLS (handle = ctx)
var _TRANSPORT_READ_SOCK = 0;
var _TRANSPORT_READ_TLS  = 1;
fn _transport_read_all(mode, handle, rbuf, rbufmax): i64 {
    var total = 0;
    var go = 1;
    while (go == 1) {
        if (total >= rbufmax) { _transport_incomplete = 1; go = 0; }   # rbuf full — more may follow
        else {
            var n = 0;
            if (mode == _TRANSPORT_READ_TLS) { n = tls_read(handle, rbuf + total, rbufmax - total); }
            else { n = taar_tcp_recv(handle, rbuf + total, rbufmax - total); }
            if (n == 0) { go = 0; }                                    # clean close / close_notify
            elif (n < 0) { _transport_incomplete = 1; go = 0; }        # timeout / reset / TLS error
            else { total = total + n; }
        }
    }
    return total;
}

# Resolve `host` (cstr), open a TCP connection to host:port, send `req`, and read
# the full response into rbuf (bounded by rbufmax). Returns total bytes read
# (>= 0), or a TRANSPORT_ERR_* (< 0). Plain HTTP only.
fn transport_fetch(host, port, req, reqlen, rbuf, rbufmax): i64 {
    _transport_incomplete = 0;
    var ip = taar_resolve_ipv4(host);
    if (ip < 0) { return TRANSPORT_ERR_RESOLVE; }

    var fd = taar_tcp_open();
    if (fd < 0) { return TRANSPORT_ERR_SOCKET; }
    taar_tcp_set_timeout_ms(fd, 10000);   # bound a stalled/keep-alive recv

    var cr = taar_tcp_connect(fd, ip, port);
    if (cr < 0) { taar_sock_close(fd); return TRANSPORT_ERR_CONNECT; }

    if (_transport_send_all(fd, req, reqlen) < 0) {
        taar_sock_close(fd);
        return TRANSPORT_ERR_SEND;
    }

    var total = _transport_read_all(_TRANSPORT_READ_SOCK, fd, rbuf, rbufmax);
    taar_sock_close(fd);
    return total;
}

#ifdef CYRIUS_TARGET_AGNOS
# CA-trust hook for agnos. cyrius's `tls_native_set_ca_system` opens the bundle
# with the Linux `sys_open(path, flags, mode)` ABI, but agnos `sys_open` is
# `(name, namelen, flags)` — so it passes namelen=0 → empty path → the CA file
# never opens → TLS_ERR_IO → fail-closed (no roots). Filed upstream as cyrius
# issue 2026-06-18-tls-native-set-ca-system-agnos-sys-open-abi. Until that lands,
# this hook (called by _agnos_tls_native_connect AFTER new_client) reads the
# staged /etc/ssl/cert.pem with the correct agnos ABI and installs it via
# tls_native_set_ca_bundle — the roots the chain then verifies against.
# The loaded bundle, cached across connects. The allocator is a bump allocator
# with no free, so the old per-connect xalloc(1 MiB) was permanently retained on
# every TLS connection — ~1 MiB leaked per redirect hop and per crawled resource.
var _agnos_ca_buf = 0;
var _agnos_ca_len = 0;

fn _agnos_ca_load(): i64 {
    if (_agnos_ca_buf != 0) { return 0; }      # already loaded
    # Distributions disagree on where the bundle lives; probe the common layouts
    # rather than assuming one. Previously only the first was tried, so an image
    # with a Debian/RHEL trust store had no roots at all and every HTTPS
    # handshake failed closed — correct, but for the wrong reason.
    var fd = 0 - 1;
    var i = 0;
    while ((i < 4) && (fd < 0)) {
        var path = "/etc/ssl/cert.pem";
        if (i == 1) { path = "/etc/ssl/certs/ca-certificates.crt"; }
        if (i == 2) { path = "/etc/pki/tls/certs/ca-bundle.crt"; }
        if (i == 3) { path = "/etc/ssl/ca-bundle.pem"; }
        var nl = 0;
        while (load8(path + nl) != 0) { nl = nl + 1; }
        fd = sys_open(path, nl, 0);
        i = i + 1;
    }
    if (fd < 0) { return 0 - 1; }              # no bundle staged → leave roots empty
    var cap = 1048576;
    var buf = xalloc(cap);
    if (buf == 0) { sys_close(fd); return 0 - 1; }   # never store into address 0
    var total = 0;
    var go = 1;
    while (go == 1) {
        var n = sys_read(fd, buf + total, cap - total);
        if (n <= 0) { go = 0; }
        else {
            total = total + n;
            if (total >= cap) { go = 0; }
        }
    }
    sys_close(fd);
    if (total <= 0) { return 0 - 1; }
    _agnos_ca_buf = buf;
    _agnos_ca_len = total;
    return 0;
}

fn _agnos_ca_hook(hook_ctx, nctx): i64 {
    if (_agnos_ca_load() < 0) { return 0; }
    tls_native_set_ca_bundle(nctx, _agnos_ca_buf, _agnos_ca_len, 0);
    return 0;
}

# agnos TLS connect via the SOVEREIGN native stack (lib/tls_native.cyr), NOT the
# lib/tls.cyr facade's tls_connect* verbs. Those verbs route through
# tls_connect_alloc → _tls_init → fdlopen_init_full, i.e. the libssl.so.3
# dynamic-loader bridge (fdlopen bootstraps ld.so to dlopen glibc). agnos
# binaries are STATIC — no ld.so, no fdlopen — so that path is both unbuildable
# (reachable-undef fdlopen_*) and structurally unusable. Wire the native client
# directly instead: new_client (defaults to TLS_VERIFY_PEER) → CA roots via the
# agnos-ABI hook → handshake over taar's socket (transport installed by caller).
# Returns a facade-shaped native shim ctx [nctx@0, 0@8, sock@16, NATIVE@24] so the
# shared tls_read/tls_write/tls_close below route to the native backend (they
# dispatch on _tls_backend==1 and never touch fdlopen). 0 on any failure.
fn _agnos_tls_native_connect(fd, host): i64 {
    var hl = 0;
    while (load8(host + hl) != 0) { hl = hl + 1; }
    var nctx = tls_native_new_client(host, hl);   # TLS_VERIFY_PEER by default
    if (nctx == 0) { return 0; }
    # tls_native_set_ca_system opens the bundle with the Linux sys_open ABI (fails
    # on agnos), so install the staged roots directly with the correct agnos ABI.
    _agnos_ca_hook(0, nctx);
    # CVE-18: tls_native_connect verifies chain + hostname fail-closed before TLS_OK.
    if (tls_native_connect(nctx, fd) != TLS_OK) { tls_native_close(nctx); return 0; }
    var ctx = xalloc(40);
    store64(ctx, nctx);
    store64(ctx + 8, 0);
    store64(ctx + 16, fd);
    store64(ctx + 24, TLS_BACKEND_NATIVE);
    return ctx;
}
#endif

# HTTPS variant: resolve + TCP connect over taar, then a TLS session via the
# stdlib (tls_connect handshakes + verifies the cert chain + hostname fail-closed,
# CVE-18). On Linux tls_native's default transport does raw read/write on taar's
# real socket fd; on agnos the fd is a sentinel so the transport + CA roots are
# wired explicitly (set_transport + _agnos_ca_hook).
fn transport_fetch_tls(host, port, req, reqlen, rbuf, rbufmax): i64 {
    _transport_incomplete = 0;
    var ip = taar_resolve_ipv4(host);
    if (ip < 0) { return TRANSPORT_ERR_RESOLVE; }

    var fd = taar_tcp_open();
    if (fd < 0) { return TRANSPORT_ERR_SOCKET; }
    taar_tcp_set_timeout_ms(fd, 10000);

    var cr = taar_tcp_connect(fd, ip, port);
    if (cr < 0) { taar_sock_close(fd); return TRANSPORT_ERR_CONNECT; }

#ifdef CYRIUS_TARGET_AGNOS
    # taar's agnos TCP "fd" is a sentinel — the real conn_id lives in a taar
    # module global — so tls_native's default raw-fd sys_read/sys_write can't
    # route. Install taar's TCP recv/send as the TLS transport (v6.2.4 hook).
    # now_fn = 0 keeps the agnos default (_tn_now_unix → sys_time_unix#46) for
    # cert-window validation. On Linux the real fd works with the default path.
    tls_native_set_transport(&taar_tcp_recv, &taar_tcp_send, 0);
    # Sovereign native handshake — no libssl/fdlopen (agnos is static, no ld.so).
    # _agnos_tls_native_connect wires new_client + agnos-ABI CA roots + connect and
    # returns a native-backed shim the shared tls_* I/O below drives.
    var ctx = _agnos_tls_native_connect(fd, host);
#endif
#ifndef CYRIUS_TARGET_AGNOS
    var ctx = tls_connect(fd, host);          # SNI + handshake + cert/hostname verify
#endif
    if (ctx == 0) { taar_sock_close(fd); return TRANSPORT_ERR_TLS; }

    # tls_write / tls_native_write already send-all internally — only the return
    # code needs checking here, not a loop.
    if (tls_write(ctx, req, reqlen) < 0) {
        tls_close(ctx);
        taar_sock_close(fd);
        return TRANSPORT_ERR_SEND;
    }

    var total = _transport_read_all(_TRANSPORT_READ_TLS, ctx, rbuf, rbufmax);
    tls_close(ctx);
    taar_sock_close(fd);
    return total;
}
