# whirl — transport: resolve + TCP connect + send + recv, plain or over TLS.
#
# Composes the taar substrate: taar_resolve_ipv4 (DNS over UDP-53) + taar's TCP
# socket primitives (taar_tcp_open / connect / send / recv / close). Sovereign,
# raw-syscall — no lib/net.cyr. HTTPS wraps the same socket in TLS: the lib/tls.cyr
# facade on Linux, tls_native directly on AGNOS (static binaries cannot use the
# libssl bridge).
#
# taar is included via lib/taar.cyr (the [deps.taar] dist bundle).

var TRANSPORT_ERR_RESOLVE = 0 - 2;
var TRANSPORT_ERR_SOCKET  = 0 - 3;
var TRANSPORT_ERR_CONNECT = 0 - 4;
var TRANSPORT_ERR_TLS     = 0 - 5;
var TRANSPORT_ERR_SEND    = 0 - 6;

# Set by every transport_fetch*: 1 when the read loop ended on a socket/TLS
# ERROR or on filling rbuf, rather than on a clean peer close. Both loops used
# to fold `n < 0` into the same branch as `n == 0`, so a mid-body timeout or RST
# returned `total` as a SUCCESSFUL fetch and whirl wrote a truncated file with
# exit 0. taar 0.5.0 separates the two on purpose (_TAAR_ERR_TIMEOUT = -11 vs 0
# for a clean close) — this flag carries that distinction up to the caller,
# which cross-checks it against Content-Length before trusting the bytes.
# A flag rather than an error return: a peer that RSTs after sending a complete
# Content-Length-delimited body is common, and must not become a hard failure.
var _transport_incomplete = 0;
# 1 when the last fetch's read ended on an error, timeout or full buffer rather
# than a clean close or a complete response.
fn transport_incomplete(): i64 { return _transport_incomplete; }

# Send all of `len` bytes. taar_tcp_send is write(2) on Linux and sock_send#48
# on agnos; BOTH document a short write ("bytes accepted, which may be < len —
# the caller loops"), and the old call discarded the return entirely, so an
# oversized -d body could be sent truncated under a Content-Length that promised
# more. 0 is a legal transient (full tx buffer), so it is tolerated with a
# bounded spin rather than treated as fatal — the same shape as taar's own
# _taar_dns_tcp_send_all. Returns 0, or TRANSPORT_ERR_SEND.
var _TRANSPORT_SEND_SPIN_MAX = 1000;
fn _transport_send_all(fd, buf, len): i64 {
    var off = 0;
    var spin = 0;
    while (off < len) {
        var w = taar_tcp_send(fd, buf + off, len - off);
        if (w < 0) { return TRANSPORT_ERR_SEND; }
        if (w == 0) {
            spin = spin + 1;
            if (spin > _TRANSPORT_SEND_SPIN_MAX) { return TRANSPORT_ERR_SEND; }
        } else {
            spin = 0;
            off = off + w;
        }
    }
    return 0;
}

# The response read loop, shared by both fetch paths. It exists once because
# the policy in it is subtle and was previously duplicated: the two copies had
# to be fixed in lockstep when error-vs-EOF conflation was found, and a third
# consumer would have had to remember. `mode` selects the reader with a direct
# call rather than a function pointer — the AGNOS arm has no executed test
# coverage, so this keeps its hot path on the same mechanism it already ships.
#   mode 0 = plain socket (handle = fd), mode 1 = TLS (handle = ctx)
var _TRANSPORT_READ_SOCK = 0;
var _TRANSPORT_READ_TLS  = 1;
fn _transport_read_all(mode, handle, rbuf, rbufmax): i64 {
    var total = 0;
    var go = 1;
    http_complete_reset();
    while (go == 1) {
        if (total >= rbufmax) { _transport_incomplete = 1; go = 0; }   # rbuf full — more may follow
        else {
            var n = 0;
            if (mode == _TRANSPORT_READ_TLS) { n = tls_read(handle, rbuf + total, rbufmax - total); }
            else { n = taar_tcp_recv(handle, rbuf + total, rbufmax - total); }
            if (n == 0) { go = 0; }                                    # clean close / close_notify
            elif (n < 0) { _transport_incomplete = 1; go = 0; }        # timeout / reset / TLS error
            else {
                total = total + n;
                # Stop as soon as the response's own framing says it is whole.
                # Reading on for a peer close we do not need cost a full receive
                # deadline per fetch on AGNOS (where the close is not surfaced
                # promptly) and one wasted syscall per fetch on Linux.
                # Incremental (0.7.2): each call resumes where the last stopped.
                if (http_complete_feed(rbuf, total) == 1) { go = 0; }
            }
        }
    }
    # Drop any interim 1xx responses (103 Early Hints) ahead of the final one, so
    # every parser after this sees the final response at offset 0.
    var base = http_complete_base();
    if ((base > 0) && (base <= total)) {
        var k = 0;
        while (k < total - base) { store8(rbuf + k, load8(rbuf + base + k)); k = k + 1; }
        total = total - base;
    }
    return total;
}

# Open a TCP socket to ip:port with whirl's 10 s deadline, which since taar 0.6.2
# bounds the connect and every send as well as every recv. Returns the fd, or a
# TRANSPORT_ERR_*. 0.7.2 checks that the deadline was SET: without it a stalled
# peer blocks forever, so a socket that will not take one is refused.
var TRANSPORT_TIMEOUT_MS = 10000;
fn _transport_connect(ip, port): i64 {
    var fd = taar_tcp_open();
    if (fd < 0) { return TRANSPORT_ERR_SOCKET; }
    if (taar_tcp_set_timeout_ms(fd, TRANSPORT_TIMEOUT_MS) < 0) {
        taar_sock_close(fd);
        return TRANSPORT_ERR_SOCKET;
    }
    if (taar_tcp_connect(fd, ip, port) < 0) { taar_sock_close(fd); return TRANSPORT_ERR_CONNECT; }
    return fd;
}

# Resolve `host` (cstr), open a TCP connection to host:port, send `req`, and read
# the full response into rbuf (bounded by rbufmax). Returns total bytes read
# (>= 0), or a TRANSPORT_ERR_* (< 0). Plain HTTP only.
fn transport_fetch(host, port, req, reqlen, rbuf, rbufmax): i64 {
    _transport_incomplete = 0;
    var ip = taar_resolve_ipv4(host);
    if (ip < 0) { return TRANSPORT_ERR_RESOLVE; }

    var fd = _transport_connect(ip, port);
    if (fd < 0) { return fd; }

    if (_transport_send_all(fd, req, reqlen) < 0) {
        taar_sock_close(fd);
        return TRANSPORT_ERR_SEND;
    }

    var total = _transport_read_all(_TRANSPORT_READ_SOCK, fd, rbuf, rbufmax);
    taar_sock_close(fd);
    return total;
}

#ifdef CYRIUS_TARGET_AGNOS
# Trust roots for an agnos TLS client ctx: the system bundle, through the stdlib.
# Returns TLS_OK, or a TLS_ERR_* (TLS_ERR_IO when no bundle is readable at any of
# /etc/ssl/cert.pem, /etc/ssl/certs/ca-certificates.crt,
# /etc/pki/tls/certs/ca-bundle.crt, /etc/ssl/ca-bundle.pem). A function of its own
# so tests/agnos_probe.cyr can measure exactly what whirl pays per connect.
#
# This replaced `_agnos_ca_hook` at 0.7.1. That hook read the bundle once into a
# whirl-owned buffer and handed it to `tls_native_set_ca_bundle` for every ctx.
# - 0.6.2: it worked around set_ca_system opening the bundle with the Linux
#   sys_open ABI on agnos. Fixed upstream in cyrius v6.2.23.
# - 0.6.8: it became a CACHE, because set_ca_system re-read 1 MiB per call and
#   this allocator never frees. The probe measured that leak, 1 MiB per
#   connect, on cyrius 6.5.35.
# - cyrius v6.5.36 made set_ca_system read the bundle once per process, and
#   6.6.13 made it share ONE parsed root set across every ctx.
# - 0.7.1: on a real kernel at 6.7.18 the hook now cost ~272,720 B per connect,
#   because set_ca_bundle parses the whole bundle into each ctx. set_ca_system
#   costs ~656 B. The cache had become the leak, so it was removed.
fn _agnos_ca_install(nctx): i64 {
    return tls_native_set_ca_system(nctx);
}

# agnos TLS connect via the SOVEREIGN native stack (lib/tls_native.cyr), NOT the
# lib/tls.cyr facade's tls_connect* verbs. Those verbs route through
# tls_connect_alloc → _tls_init → fdlopen_init_full, i.e. the libssl.so.3
# dynamic-loader bridge (fdlopen bootstraps ld.so to dlopen glibc). agnos
# binaries are STATIC — no ld.so, no fdlopen — so that path is both unbuildable
# (reachable-undef fdlopen_*) and structurally unusable. Wire the native client
# directly instead: new_client (defaults to TLS_VERIFY_PEER) → system CA roots →
# handshake over taar's socket (transport installed by caller).
# Returns a facade-shaped native shim ctx [nctx@0, 0@8, sock@16, NATIVE@24] so the
# shared tls_read/tls_write/tls_close below route to the native backend. They
# dispatch per ctx (a 0 at +8 marks a native shim, lib/tls.cyr _tls_shim_native)
# and never touch fdlopen. 0 on any failure.
fn _agnos_tls_native_connect(fd, host): i64 {
    var hl = 0;
    while (load8(host + hl) != 0) { hl = hl + 1; }
    var nctx = tls_native_new_client(host, hl);   # TLS_VERIFY_PEER by default
    if (nctx == 0) { return 0; }
    # No readable trust store → stop here, before any network I/O. The verifier
    # would refuse the chain anyway (no roots = TLS_ERR_CERT_INVALID, fail
    # closed), but the retired hook ignored a failed load and handshook anyway.
    if (_agnos_ca_install(nctx) != TLS_OK) { tls_native_close(nctx); return 0; }
    # CVE-18: tls_native_connect verifies chain + hostname fail-closed before TLS_OK.
    if (tls_native_connect(nctx, fd) != TLS_OK) { tls_native_close(nctx); return 0; }
    var ctx = xalloc(40);
    store64(ctx, nctx);
    store64(ctx + 8, 0);
    store64(ctx + 16, fd);
    store64(ctx + 24, TLS_BACKEND_NATIVE);
    return ctx;
}
#endif

# HTTPS variant: resolve + TCP connect over taar, then a TLS session via the
# stdlib (tls_connect handshakes + verifies the cert chain + hostname fail-closed,
# CVE-18). On Linux tls_native's default transport does raw read/write on taar's
# real socket fd; on agnos the fd is a sentinel so the transport + CA roots are
# wired explicitly (set_transport + _agnos_ca_install).
fn transport_fetch_tls(host, port, req, reqlen, rbuf, rbufmax): i64 {
    _transport_incomplete = 0;
    var ip = taar_resolve_ipv4(host);
    if (ip < 0) { return TRANSPORT_ERR_RESOLVE; }

    var fd = _transport_connect(ip, port);
    if (fd < 0) { return fd; }

    #ifdef CYRIUS_TARGET_AGNOS
    # taar's agnos TCP "fd" is a sentinel — the real conn_id lives in a taar
    # module global — so tls_native's default raw-fd sys_read/sys_write can't
    # route. Install taar's TCP recv/send as the TLS transport (v6.2.4 hook).
    # now_fn = 0 keeps the agnos default (_tn_now_unix → sys_time_unix#46) for
    # cert-window validation. On Linux the real fd works with the default path.
    tls_native_set_transport(&taar_tcp_recv, &taar_tcp_send, 0);
    # Sovereign native handshake — no libssl/fdlopen (agnos is static, no ld.so).
    # _agnos_tls_native_connect wires new_client + system CA roots + connect and
    # returns a native-backed shim the shared tls_* I/O below drives.
    var ctx = _agnos_tls_native_connect(fd, host);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var ctx = tls_connect(fd, host);          # SNI + handshake + cert/hostname verify
    #endif
    if (ctx == 0) { taar_sock_close(fd); return TRANSPORT_ERR_TLS; }

    # tls_write / tls_native_write already send-all internally — only the return
    # code needs checking here, not a loop.
    if (tls_write(ctx, req, reqlen) < 0) {
        tls_close(ctx);
        taar_sock_close(fd);
        return TRANSPORT_ERR_SEND;
    }

    var total = _transport_read_all(_TRANSPORT_READ_TLS, ctx, rbuf, rbufmax);
    tls_close(ctx);
    taar_sock_close(fd);
    return total;
}

# Fetch over TLS when `is_https` is 1, else plain. The single dispatch point: the
# fetch loop, the crawl and the robots.txt fetch each carried a copy before 0.7.2.
fn transport_fetch_url(is_https, host, port, req, reqlen, rbuf, rbufmax): i64 {
    if (is_https == 1) { return transport_fetch_tls(host, port, req, reqlen, rbuf, rbufmax); }
    return transport_fetch(host, port, req, reqlen, rbuf, rbufmax);
}

# Fetch, retrying up to `retries` times with linear backoff (200 ms × attempt).
# Retried: a failure before the request was fully sent (resolve, socket, connect,
# send), and, for an idempotent method, an empty response. NOT retried (0.7.2):
#   - a TLS failure: a certificate that failed verification fails the same way
#     every time (curl does not retry it either); each refusal under
#     `--retry 3` took ~1.2 s;
#   - a non-idempotent request (POST) once it was sent: the server may have acted
#     on it, and a consumed POST was sent 4 times under `--retry 3`.
# Returns transport_fetch_url's result for the last attempt.
var TRANSPORT_RETRY_BACKOFF_MS = 200;
# Fetch with the retry policy above. Returns the last attempt's result.
fn transport_fetch_retry(is_https, host, port, req, reqlen, rbuf, rbufmax, retries, idempotent): i64 {
    var attempt = 0;
    var total = 0 - 1;
    while (attempt <= retries) {
        total = transport_fetch_url(is_https, host, port, req, reqlen, rbuf, rbufmax);
        if (total > 0) { return total; }
        var again = 0;
        if ((total == TRANSPORT_ERR_RESOLVE) || (total == TRANSPORT_ERR_SOCKET)
            || (total == TRANSPORT_ERR_CONNECT) || (total == TRANSPORT_ERR_SEND)) { again = 1; }
        elif ((total == 0) && (idempotent == 1)) { again = 1; }
        if (again == 0) { return total; }
        attempt = attempt + 1;
        if (attempt <= retries) { sleep_ms(TRANSPORT_RETRY_BACKOFF_MS * attempt); }
    }
    return total;
}

# A one-line reason for a failed fetch (`total` <= 0), for the error message.
# 0.7.2: every failure read "connection failed", so a DNS failure (more likely
# since taar 0.6.2's fail-closed resolv.conf) looked like a refused connection.
fn transport_strerror(total): i64 {
    if (total == TRANSPORT_ERR_RESOLVE) { return "could not resolve host"; }
    if (total == TRANSPORT_ERR_TLS) { return "TLS failed (handshake or certificate verification)"; }
    if (total == TRANSPORT_ERR_SEND) { return "connection failed while sending"; }
    if (total == 0) { return "empty response"; }
    return "connection failed";
}

