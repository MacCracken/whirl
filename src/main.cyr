# whirl — main entry point. Wires CLI → URL → transport → HTTP parse → output.
#
# A single fetch (with -L redirects, -C resume, --retry) lives here; the
# recursive fetch (-r) is in mirror.cyr. Stdlib auto-included.

include "lib/taar.cyr"
include "src/version.cyr"
include "src/util.cyr"
include "src/url.cyr"
include "src/http.cyr"
include "src/links.cyr"
include "src/crawl.cyr"
include "src/cli.cyr"
include "src/transport.cyr"
include "src/output.cyr"
include "src/mirror.cyr"

var WHIRL_MAX_HOPS = 10;          # redirects followed under -L
var WHIRL_REQ_SLACK = 4096;       # request buffer beyond the body

# Build a "Range: bytes=<off>-" header cstr (for -C resume).
fn _build_range_header(off): i64 {
    var tmp[24];
    var nl = fmt_int_buf(off, &tmp);
    return util_concat2("Range: bytes=", util_concat2(util_dup_range(&tmp, nl), "-"));
}

# argv as a contiguous array of cstr pointers, for cli_parse.
fn _materialize_argv(ac): i64 {
    var av = xalloc(ac * 8);
    var i = 0;
    while (i < ac) { store64(av + i * 8, argv(i)); i = i + 1; }
    return av;
}

# Copy `hdrs` minus any credential header into _stripped_hdrs; returns the new
# count. A fresh array rather than an in-place edit, so the caller's -H list is
# left intact for any later use.
var _stripped_hdrs = 0;
fn _strip_credentials(hdrs, nhdrs): i64 {
    _stripped_hdrs = xalloc((nhdrs + 1) * 8);
    var n = 0;
    var i = 0;
    while (i < nhdrs) {
        var h = load64(hdrs + i * 8);
        if (http_hdr_is_credential(h) == 0) {
            store64(_stripped_hdrs + n * 8, h);
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn _print_help(): i64 {
    _puts("whirl — curl + wget unified, in sovereign Cyrius.\n\n");
    _puts("usage: whirl [options] <http://... | https://...>\n");
    _puts("  -X METHOD   request method (default GET, or POST when -d is given)\n");
    _puts("  -d DATA     request body (sets POST + Content-Length; default\n");
    _puts("              Content-Type application/x-www-form-urlencoded)\n");
    _puts("              @file reads a file, @- reads stdin (1 MiB cap)\n");
    _puts("  --data-binary D  request body, raw (same loader; @file / @-)\n");
    _puts("  -H 'H: v'   add a request header (repeatable, up to 16)\n");
    _puts("  -A UA       set the User-Agent (alias --user-agent)\n");
    _puts("  -o FILE     write the response body to FILE (default: stdout)\n");
    _puts("  -O          write to a filename derived from the URL\n");
    _puts("  -C          resume a partial download (-o/-O file; Range request)\n");
    _puts("  -i          include response headers in the output\n");
    _puts("  -I          HEAD request (headers only)\n");
    _puts("  -f          fail (exit 22, no body) on HTTP >= 400\n");
    _puts("  -L          follow redirects (3xx Location, up to 10)\n");
    _puts("  -r          recursive fetch: same-origin links, mirrored under ./HOST[:PORT]/\n");
    _puts("  -l N        recursion depth for -r (default 1)\n");
    _puts("  --retry N   retry transient failures N times (linear backoff)\n");
    _puts("  -h          this help\n");
    _puts("\nexit status: 0 ok, 2 usage or bad input, 9 transfer / response / write\n");
    _puts("failure (incl. too many redirects), 22 HTTP >= 400 under -f\n");
    return 0;
}

fn _warn_truncated(what): i64 {
    _eputs("whirl: incomplete response (");
    _eputs(what);
    _eputs(") — connection ended early or exceeded the ");
    _eput_int(WHIRL_RBUF_SZ);
    _eputs("-byte cap\n");
    return 0;
}

# Emit a complete response: the decoded body, or (-i) the headers then the
# decoded body, or (-I) the headers. Returns the exit code.
fn _emit_body(rbuf, total, outfile): i64 {
    # A truncated transfer must never be written out as if it were complete.
    if (http_response_truncated(rbuf, total, transport_incomplete()) == 1) {
        _warn_truncated("body");
        return 9;
    }
    if (cli_head() == 1) {
        if (output_write(rbuf, total, outfile) < 0) { _eputs("whirl: write failed\n"); return 9; }
        return 0;
    }
    var bodyp = xalloc(8);
    var n = http_decode_body(rbuf, total, util_scratch(), WHIRL_RBUF_SZ, bodyp);
    if (n == (0 - 2)) { _eputs("whirl: no response body\n"); return 9; }
    if (n < 0) { _eputs("whirl: malformed chunked body\n"); return 9; }
    var body = load64(bodyp);
    if (cli_include() == 1) {
        # -i: status line + headers + the DECODED body, written once. (Emitting
        # rbuf verbatim put raw hex chunk framing in the output.) One buffer,
        # because output_write truncates a file sink on every call.
        var ib = http_body_offset(rbuf, total);
        var comb = xalloc(ib + n);
        var ci = 0;
        while (ci < ib) { store8(comb + ci, load8(rbuf + ci)); ci = ci + 1; }
        var cj = 0;
        while (cj < n) { store8(comb + ib + cj, load8(body + cj)); cj = cj + 1; }
        body = comb;
        n = ib + n;
    }
    if (output_write(body, n, outfile) < 0) { _eputs("whirl: write failed\n"); return 9; }
    return 0;
}

# -C: append a 206 Partial Content to `outfile`, which holds `resume_off` bytes.
# Returns the exit code.
#
# 0.7.2: the 206 went through none of the checks every other body gets. A chunked
# 206 appended its hex framing to the file. A 206 cut short was appended and
# reported "resumed", exit 0. A Content-Range starting anywhere but the requested
# byte was appended anyway (bytes 0-9 onto a 5-byte file made HELLOHELLOWORLD).
# Each case was a corrupt file and exit 0.
fn _resume_append(rbuf, total, outfile, resume_off): i64 {
    if (http_response_truncated(rbuf, total, transport_incomplete()) == 1) {
        _warn_truncated("partial content");
        return 9;
    }
    if (http_content_range(rbuf, total) == 0) {
        _eputs("whirl: 206 without a usable Content-Range; not appending\n");
        return 9;
    }
    if (http_cr_first() != resume_off) {
        _eputs("whirl: server resumed at byte ");
        _eput_int(http_cr_first());
        _eputs(", not ");
        _eput_int(resume_off);
        _eputs("; not appending\n");
        return 9;
    }
    var bodyp = xalloc(8);
    var n = http_decode_body(rbuf, total, util_scratch(), WHIRL_RBUF_SZ, bodyp);
    if (n < 0) { _eputs("whirl: malformed 206 response\n"); return 9; }
    if (output_append(load64(bodyp), n, outfile) < 0) {
        _eputs("whirl: resume append failed (write error, or a file too large to resume on this target)\n");
        return 9;
    }
    _eputs("whirl: resumed at "); _eput_int(resume_off); _eputs(" bytes\n");
    return 0;
}

# The method a redirect is followed with (RFC 9110 §15.4). 307 and 308 keep the
# method and the body. 303 turns anything but HEAD into GET. 301 and 302 turn a
# POST into GET, as every client does, and keep other methods. Before 0.7.2 every
# redirect became a bodyless GET: a POST behind a 307 arrived as a GET with its
# data gone, and `-I -L` sent a GET on the second hop and printed body bytes.
fn _redirect_method(status, meth): i64 {
    if ((status == 307) || (status == 308)) { return meth; }
    if (status == 303) {
        if (util_streq_ci(meth, "HEAD") == 1) { return meth; }
        return "GET";
    }
    if (util_streq_ci(meth, "POST") == 1) { return "GET"; }
    return meth;
}

# Entry point: parse argv, fetch (or crawl, with -r), write the result.
# Exit codes: 0 ok, 2 usage / bad input, 9 transfer, response or write failure
# (a redirect -L cannot follow is one), 22 HTTP >= 400 under -f.
fn main() {
    alloc_init();
    args_init();

    var ac = argc();
    var av = _materialize_argv(ac);
    var rc = cli_parse(ac, av);
    if (rc == CLI_HELP) { _print_help(); return 0; }
    if (rc == CLI_ERR)  { _eputs("whirl: usage: whirl [options] <url>  (whirl -h lists them)\n"); return 2; }

    if (cli_bodyerr() == CLI_BODY_ENOENT) {
        _eputs("whirl: cannot read the request body\n");
        return 2;
    }
    if (cli_bodyerr() == CLI_BODY_TOOBIG) {
        _eputs("whirl: request body exceeds the ");
        _eput_int(CLI_BODY_MAX);
        _eputs("-byte cap\n");
        return 2;
    }

    if (cli_useragent() != 0) { http_set_user_agent(cli_useragent()); }   # -A override

    var u = url_new();
    if (url_parse(cli_url(), u) != URL_PARSE_OK) {
        _eputs("whirl: bad URL (need http://... or https://...)\n");
        return 2;
    }
    var is_https = url_is_https(u);
    var host = url_host(u);
    var port = url_port(u);
    var path = url_path(u);

    if (cli_recursive() == 1) {
        return mirror_crawl(cli_url(), host, is_https, port, cli_depth());
    }

    var rbuf = xalloc(WHIRL_RBUF_SZ);
    var hops = 0;
    var drop_creds = 0;      # set once a redirect crosses origin (see below)

    # -o FILE wins; else -O derives the name from the URL path.
    var outfile = cli_outfile();
    if ((outfile == 0) && (cli_remote() == 1)) { outfile = url_filename(path); }

    # -C resume: continue from the existing output file's size via a Range request.
    var resume_off = 0;
    if ((cli_resume() == 1) && (outfile != 0)) { resume_off = output_file_size(outfile); }

    var meth = cli_method();
    var bdy = cli_body();
    var blen = cli_bodylen();
    var ret = 0;
    var redirect = 1;
    while (redirect == 1) {
        redirect = 0;

        var hdrs = cli_hdrs();
        var nhdrs = cli_nhdrs();
        if (drop_creds == 1) { nhdrs = _strip_credentials(hdrs, nhdrs); hdrs = _stripped_hdrs; }
        if (resume_off > 0) {
            # -C: Range on every hop (0.7.2), so a redirect does not turn a
            # resume into a full re-download.
            var aug = xalloc((nhdrs + 1) * 8);
            var hi = 0;
            while (hi < nhdrs) { store64(aug + hi * 8, load64(hdrs + hi * 8)); hi = hi + 1; }
            store64(aug + nhdrs * 8, _build_range_header(resume_off));
            hdrs = aug;
            nhdrs = nhdrs + 1;
        }
        http_set_no_body(util_streq_ci(meth, "HEAD"));
        var reqsz = WHIRL_REQ_SLACK + blen;
        var req = xalloc(reqsz);
        # RFC 9110 s7.2: Host carries the port whenever it is not the scheme
        # default. A bare host made virtual-host routing on a non-default port
        # resolve to the wrong site.
        var reqlen = http_build_request(meth, _authority(host, is_https, port), path,
          hdrs, nhdrs, bdy, blen, req, reqsz);
        if (reqlen < 0) { _eputs("whirl: request too large to build\n"); return 2; }

        var total = transport_fetch_retry(is_https, host, port, req, reqlen, rbuf, WHIRL_RBUF_SZ,
          cli_retries(), http_method_idempotent(meth));
        if (total <= 0) {
            _eputs("whirl: ");
            _eputs(transport_strerror(total));
            if (total == TRANSPORT_ERR_RESOLVE) { _eputs(" "); util_eputs_safe(host); }
            _eputs("\n");
            return 9;
        }

        var status = http_status_code(rbuf, total);
        if (status < 0) { _eputs("whirl: malformed response\n"); return 9; }

        var loc = 0;
        if ((status >= 300) && (status < 400) && (status != 304)) { loc = http_header_dup(rbuf, total, "location"); }
        if ((cli_follow() == 1) && (loc != 0)) {
            # 0.7.2: a redirect -L cannot follow is a failure (exit 9), not the
            # 3xx stub written out with exit 0 and "(use -L to follow)".
            if (hops >= WHIRL_MAX_HOPS) {
                _eputs("whirl: too many redirects (");
                _eput_int(WHIRL_MAX_HOPS);
                _eputs(")\n");
                return 9;
            }
            var target = _abs_location(loc, is_https, host, port, path);
            var u2 = url_new();
            var ok = 0;
            if (target != 0) {
                if (url_parse(target, u2) == URL_PARSE_OK) { ok = 1; }
            }
            if (ok == 0) {
                _eputs("whirl: cannot follow redirect to ");
                util_eputs_safe(loc);
                _eputs("\n");
                return 9;
            }
            # Cross-origin hop: drop caller-supplied credentials. They were
            # previously replayed verbatim, so a 302 from any site whirl was given
            # an -H 'Authorization: ...' for could harvest that credential by
            # pointing at a host it controls.
            if (_same_origin(is_https, host, port, u2) == 0) { drop_creds = 1; }
            var nm = _redirect_method(status, meth);
            if (streq(nm, meth) == 0) { bdy = 0; blen = 0; }   # a changed method drops the body
            meth = nm;
            is_https = url_is_https(u2);
            host = url_host(u2);
            port = url_port(u2);
            path = url_path(u2);
            hops = hops + 1;
            redirect = 1;
            continue;
        }

        if (loc != 0) {
            # Unfollowed 3xx (no -L): name the target on stderr so an empty body
            # is not a silent dead end. Escaped: the server chose these bytes.
            _eputs("whirl: ");
            _eput_int(status);
            _eputs(" redirect -> ");
            util_eputs_safe(loc);
            _eputs("  (use -L to follow)\n");
        }
        if ((cli_fail() == 1) && (status >= 400)) {   # -f: no body, exit 22
            _eputs("whirl: HTTP ");
            _eput_int(status);
            _eputs("\n");
            ret = 22;
        }
        elif ((resume_off > 0) && (status == 206)) {
            ret = _resume_append(rbuf, total, outfile, resume_off);
        }
        elif ((resume_off > 0) && (status == 416)) {
            # 416 to a Range at the file's end usually means "already complete".
            # If the server states its length and it is not the local size, the
            # local file is not a prefix of this resource: say so (0.7.2).
            http_content_range(rbuf, total);
            if ((http_cr_total() >= 0) && (http_cr_total() != resume_off)) {
                _eputs("whirl: cannot resume: the server has ");
                _eput_int(http_cr_total());
                _eputs(" bytes, the local file ");
                _eput_int(resume_off);
                _eputs("\n");
                ret = 9;
            } else {
                _eputs("whirl: already complete\n");
                ret = 0;
            }
        }
        else {
            ret = _emit_body(rbuf, total, outfile);   # 200 / no-resume → overwrite
        }
    }
    return ret;
}

var r = main();
syscall(SYS_EXIT, r);
